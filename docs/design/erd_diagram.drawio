      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p1" name="00b. Danh mục bảng">
    <mxGraphModel dx="2347" dy="1467" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;1. Bệnh viện &amp;amp; cấu hình&lt;/b&gt;&lt;br&gt;• hospital &lt;span style=&quot;color:#666&quot;&gt;– Bệnh viện&lt;/span&gt;&lt;br&gt;• facility &lt;span style=&quot;color:#666&quot;&gt;– Cơ sở của bệnh viện; BN chọn cơ sở khi đặt lịch, vùng phục vụ tính theo cơ sở&lt;/span&gt;&lt;br&gt;• hospital_payment_account &lt;span style=&quot;color:#666&quot;&gt;– Tài khoản nhận tiền của BV liên kết cổng thanh toán&lt;/span&gt;&lt;br&gt;• system_parameter &lt;span style=&quot;color:#666&quot;&gt;– Tham số chung do Admin nền tảng cấu hình theo ngày hiệu lực&lt;/span&gt;&lt;br&gt;• hospital_setting &lt;span style=&quot;color:#666&quot;&gt;– Cấu hình riêng BV có ngày hiệu lực: tỷ lệ chia, mức phạt / hoàn, khung giờ trong khung chung…&lt;/span&gt;" vertex="1">
          <mxGeometry height="124" width="720" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;2. Tài khoản &amp;amp; phân quyền&lt;/b&gt;&lt;br&gt;• user_account &lt;span style=&quot;color:#666&quot;&gt;– Tài khoản đăng nhập bằng email cho mọi tác nhân&lt;/span&gt;&lt;br&gt;• email_code &lt;span style=&quot;color:#666&quot;&gt;– Mã / link gửi qua email: đăng ký, 2 lớp, quên mật khẩu, kích hoạt, xác thực lại&lt;/span&gt;&lt;br&gt;• hospital_admin_role &lt;span style=&quot;color:#666&quot;&gt;– Vai trò con của Quản trị BV: trưởng / điều phối / kế toán / nhân sự – chất lượng&lt;/span&gt;&lt;br&gt;• terms_version &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• terms_acceptance &lt;span style=&quot;color:#666&quot;&gt;– Đồng ý điều khoản theo phiên bản&lt;/span&gt;&lt;br&gt;• audit_log &lt;span style=&quot;color:#666&quot;&gt;– Nhật ký kiểm toán &amp;amp; truy cập hồ sơ, chỉ ghi thêm&lt;/span&gt;" vertex="1">
          <mxGeometry height="142" width="720" x="40" y="254" as="geometry" />
        </mxCell>
        <mxCell id="c226" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;3. Nhân sự (điều dưỡng, bác sĩ)&lt;/b&gt;&lt;br&gt;• staff_profile &lt;span style=&quot;color:#666&quot;&gt;– Hồ sơ nhân sự ĐD / BS gắn BV; trạng thái xác minh 2 bước&lt;/span&gt;&lt;br&gt;• staff_document &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• staff_review_event &lt;span style=&quot;color:#666&quot;&gt;– Lịch sử duyệt / bổ sung / từ chối / khóa hồ sơ nhân sự&lt;/span&gt;&lt;br&gt;• nurse_skill &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_service_area &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_availability &lt;span style=&quot;color:#666&quot;&gt;– Lịch trống điều dưỡng khai báo cho 14 ngày tới&lt;/span&gt;&lt;br&gt;• doctor_on_call_shift &lt;span style=&quot;color:#666&quot;&gt;– Lịch trực bác sĩ: phân loại khi AI lỗi, duyệt y lệnh, đầu mối SOS&lt;/span&gt;&lt;br&gt;• staff_lock &lt;span style=&quot;color:#666&quot;&gt;– Tạm khóa kỹ thuật nhận ca&lt;/span&gt;&lt;br&gt;• staff_score_event &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" vertex="1">
          <mxGeometry height="196" width="720" x="40" y="416" as="geometry" />
        </mxCell>
        <mxCell id="c227" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;4. Bệnh nhân &amp;amp; đồng ý dữ liệu&lt;/b&gt;&lt;br&gt;• patient_profile &lt;span style=&quot;color:#666&quot;&gt;– Hồ sơ người được chăm sóc; một tài khoản quản lý nhiều hồ sơ người thân&lt;/span&gt;&lt;br&gt;• patient_address &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• patient_consent &lt;span style=&quot;color:#666&quot;&gt;– Consent xử lý dữ liệu sức khỏe theo từng hồ sơ&lt;/span&gt;&lt;br&gt;• medical_order &lt;span style=&quot;color:#666&quot;&gt;– Chỉ định / y lệnh BN tải lên cho dịch vụ cần y lệnh, bác sĩ trực kiểm tra&lt;/span&gt;&lt;br&gt;• patient_abuse_flag &lt;span style=&quot;color:#666&quot;&gt;– Cờ lạm dụng theo tài khoản BN, chỉ đổi người quyết khi quá hạn&lt;/span&gt;" vertex="1">
          <mxGeometry height="124" width="720" x="40" y="632" as="geometry" />
        </mxCell>
        <mxCell id="c228" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;5. Dịch vụ &amp;amp; bảng giá&lt;/b&gt;&lt;br&gt;• care_report_template &lt;span style=&quot;color:#666&quot;&gt;– Biểu mẫu báo cáo chăm sóc theo loại dịch vụ, có trường bắt buộc&lt;/span&gt;&lt;br&gt;• service &lt;span style=&quot;color:#666&quot;&gt;– Danh mục dịch vụ / vật tư của BV với cờ được phép tại nhà và cần y lệnh&lt;/span&gt;&lt;br&gt;• service_price &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" vertex="1">
          <mxGeometry height="88" width="720" x="40" y="776" as="geometry" />
        </mxCell>
        <mxCell id="c229" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;6. Đặt lịch &amp;amp; điều phối&lt;/b&gt;&lt;br&gt;• care_order &lt;span style=&quot;color:#666&quot;&gt;– Đơn chăm sóc&lt;/span&gt;&lt;br&gt;• order_status_history &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• triage_assessment &lt;span style=&quot;color:#666&quot;&gt;– Phân loại triệu chứng 4 nhóm bằng AI hoặc bác sĩ trực; chỉ được bổ sung, không hạ mức&lt;/span&gt;&lt;br&gt;• order_assignment &lt;span style=&quot;color:#666&quot;&gt;– Mỗi lượt mời / gán ĐD cho đơn: BN chọn, tự gán, mời thay, điều thủ công&lt;/span&gt;&lt;br&gt;• replacement_case &lt;span style=&quot;color:#666&quot;&gt;– Báo nghỉ / đổi người / bom ca: tìm người thay và xét vi phạm một lần&lt;/span&gt;&lt;br&gt;• order_reschedule &lt;span style=&quot;color:#666&quot;&gt;– Đổi lịch đơn đặt trước đã cọc, tối đa 2 lần&lt;/span&gt;" vertex="1">
          <mxGeometry height="142" width="720" x="40" y="884" as="geometry" />
        </mxCell>
        <mxCell id="c230" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;7. Thực hiện ca chăm sóc&lt;/b&gt;&lt;br&gt;• care_visit &lt;span style=&quot;color:#666&quot;&gt;– Diễn biến ca tại nhà: xuất phát, check-in, bắt đầu, kết thúc&lt;/span&gt;&lt;br&gt;• visit_location_point &lt;span style=&quot;color:#666&quot;&gt;– Vị trí ĐD từ lúc xuất phát đến check-in; phát hiện tắt định vị &amp;gt; 10 phút&lt;/span&gt;&lt;br&gt;• visit_code &lt;span style=&quot;color:#666&quot;&gt;– Mã hiển thị trên app BN để xác nhận trong ca: check-in, bảng kê, phát sinh, dừng ca&lt;/span&gt;&lt;br&gt;• care_report &lt;span style=&quot;color:#666&quot;&gt;– Báo cáo chăm sóc bắt buộc; đủ trường → ca Hoàn tất, lưu vào hồ sơ BN tại BV&lt;/span&gt;&lt;br&gt;• care_report_revision &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• handover &lt;span style=&quot;color:#666&quot;&gt;– Bàn giao khi thay người hoặc dừng ca: người giao, người nhận, nội dung&lt;/span&gt;&lt;br&gt;• addon_request &lt;span style=&quot;color:#666&quot;&gt;– Dịch vụ phát sinh trong ca nhánh A / B / C&lt;/span&gt;&lt;br&gt;• care_stop &lt;span style=&quot;color:#666&quot;&gt;– Dừng ca giữa chừng: lý do, phí tạm tính / chốt, đơn con&lt;/span&gt;&lt;br&gt;• chat_message &lt;span style=&quot;color:#666&quot;&gt;– Chat / gọi BN – ĐD trong app theo đơn, không dùng SĐT&lt;/span&gt;&lt;br&gt;• nurse_rating &lt;span style=&quot;color:#666&quot;&gt;– Đánh giá ĐD, không bắt buộc&lt;/span&gt;" vertex="1">
          <mxGeometry height="214" width="720" x="40" y="1046" as="geometry" />
        </mxCell>
        <mxCell id="c231" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;8. Bảng kê, thanh toán &amp;amp; hoàn tiền&lt;/b&gt;&lt;br&gt;• order_line &lt;span style=&quot;color:#666&quot;&gt;– Dòng bảng kê ca: dịch vụ gốc, phát sinh, vật tư, phí đến nhà&lt;/span&gt;&lt;br&gt;• line_dispute &lt;span style=&quot;color:#666&quot;&gt;– Khiếu nại dòng bảng kê trước&lt;/span&gt;&lt;br&gt;• payment_transaction &lt;span style=&quot;color:#666&quot;&gt;– Giao dịch cọc / phần còn lại qua cổng hoặc tiền mặt; tiền về TK bệnh viện&lt;/span&gt;&lt;br&gt;• gateway_webhook_event &lt;span style=&quot;color:#666&quot;&gt;– Kết quả giao dịch / hoàn tiền do cổng gửi về&lt;/span&gt;&lt;br&gt;• refund &lt;span style=&quot;color:#666&quot;&gt;– Lệnh hoàn tiền: tự động theo BR-04, ngoại lệ, thủ công sau thanh toán&lt;/span&gt;&lt;br&gt;• deposit_exception_request &lt;span style=&quot;color:#666&quot;&gt;– BN xin ngoại lệ hoàn cọc, QT BV duyệt&lt;/span&gt;&lt;br&gt;• cash_collection &lt;span style=&quot;color:#666&quot;&gt;– Thu tiền mặt tại nhà, hai bên cùng xác nhận số tiền&lt;/span&gt;&lt;br&gt;• cash_remittance &lt;span style=&quot;color:#666&quot;&gt;– ĐD nộp tiền mặt về thủ quỹ BV, hạn 48h&lt;/span&gt;&lt;br&gt;• financial_entry &lt;span style=&quot;color:#666&quot;&gt;– Sổ bút toán chỉ ghi thêm: cọc 4 nhóm, thu, hoàn, tiền mặt ĐD giữ / nộp, bù công&lt;/span&gt;&lt;br&gt;• patient_invoice &lt;span style=&quot;color:#666&quot;&gt;– Hóa đơn điện tử BV xuất cho BN, gồm hóa đơn điều chỉnh&lt;/span&gt;" vertex="1">
          <mxGeometry height="214" width="720" x="40" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;9. Đối soát &amp;amp; phí nền tảng&lt;/b&gt;&lt;br&gt;• reconciliation_period &lt;span style=&quot;color:#666&quot;&gt;– Kỳ đối chiếu tháng theo BV&lt;/span&gt;&lt;br&gt;• reconciliation_discrepancy &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• platform_fee_invoice &lt;span style=&quot;color:#666&quot;&gt;– Hóa đơn phí nền tảng gửi BV&lt;/span&gt;&lt;br&gt;• nurse_earning_statement &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_earning_item &lt;span style=&quot;color:#666&quot;&gt;– Chi tiết thu nhập ĐD theo đơn&lt;/span&gt;" vertex="1">
          <mxGeometry height="124" width="720" x="800" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;10. Khiếu nại, vi phạm, sự cố &amp;amp; SOS&lt;/b&gt;&lt;br&gt;• staff_violation &lt;span style=&quot;color:#666&quot;&gt;– Nhật ký vi phạm ĐD; đếm cửa sổ 30 ngày cuộn theo nhóm BR-01 / BR-02&lt;/span&gt;&lt;br&gt;• no_ack_event &lt;span style=&quot;color:#666&quot;&gt;– Lần không bấm Đã nhận đơn trong 5 phút&lt;/span&gt;&lt;br&gt;• complaint &lt;span style=&quot;color:#666&quot;&gt;– Khiếu nại về ĐD / nền tảng, báo cáo hành vi BN, phúc tra&lt;/span&gt;&lt;br&gt;• complaint_event &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• incident_report &lt;span style=&quot;color:#666&quot;&gt;– Sự cố tại nhà, ghi nhận riêng khỏi khiếu nại&lt;/span&gt;&lt;br&gt;• sos_incident &lt;span style=&quot;color:#666&quot;&gt;– SOS &amp;amp; ứng phó khẩn cấp; hệ thống không tự gọi 115&lt;/span&gt;&lt;br&gt;• sos_escalation_event &lt;span style=&quot;color:#666&quot;&gt;– Từng nấc báo SOS: đầu mối trực → quá 5 phút chưa xác nhận → đầu mối dự phòng, chỉ ghi thêm&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="720" x="800" y="254" as="geometry" />
        </mxCell>
        <mxCell id="c234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;11. AI rủi ro &amp;amp; tái khám&lt;/b&gt;&lt;br&gt;• risk_assessment &lt;span style=&quot;color:#666&quot;&gt;– AI phân tích rủi ro từ báo cáo chăm sóc&lt;/span&gt;&lt;br&gt;• risk_alert &lt;span style=&quot;color:#666&quot;&gt;– Cảnh báo rủi ro cao gửi bác sĩ phụ trách / trực&lt;/span&gt;&lt;br&gt;• followup_case &lt;span style=&quot;color:#666&quot;&gt;– Đề xuất → xác nhận → phân công → kế hoạch tái khám&lt;/span&gt;&lt;br&gt;• doctor_access_grant &lt;span style=&quot;color:#666&quot;&gt;– Quyền có thời hạn cho bác sĩ xem lịch sử chăm sóc tại BV mình; BN thu hồi được&lt;/span&gt;" vertex="1">
          <mxGeometry height="106" width="720" x="800" y="434" as="geometry" />
        </mxCell>
        <mxCell id="c235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;12. Dữ liệu cá nhân (xóa dữ liệu)&lt;/b&gt;&lt;br&gt;• data_deletion_request &lt;span style=&quot;color:#666&quot;&gt;– Yêu cầu xóa dữ liệu, xử lý trong 72h&lt;/span&gt;&lt;br&gt;• data_deletion_item &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c236" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;arcSize=4;" value="&lt;b&gt;13. Thông báo, hẹn giờ &amp;amp; quyết định tự động&lt;/b&gt;&lt;br&gt;• notification &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• scheduled_timer &lt;span style=&quot;color:#666&quot;&gt;– Bộ hẹn giờ ⏱ của các luồng; worker quét due_at để chạy hành động hết hạn&lt;/span&gt;&lt;br&gt;• overdue_decision &lt;span style=&quot;color:#666&quot;&gt;– Quyết định tài chính tự động khi quá hạn, lưu mã Fx + mốc + lý do&lt;/span&gt;" vertex="1">
          <mxGeometry height="88" width="720" x="800" y="650" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="01. Bệnh viện &amp; cấu hình">
    <mxGraphModel dx="1242" dy="776" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="hospital" tooltip="Bệnh viện (tenant) ký hợp đồng với nền tảng, đứng tên nhận tiền (UC80, BR-05)" id="c238">
          <mxCell parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;fontSize=13;html=1;" vertex="1">
            <mxGeometry height="234" width="330" x="40" y="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="c239" parent="c238" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;PK&lt;/td&gt;&lt;td&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;uuid NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="22" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="c240" parent="c238" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;UQ&lt;/td&gt;&lt;td&gt;code&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="22" width="330" y="52" as="geometry" />
        </mxCell>
        <mxCell id="c241" parent="c238" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;name&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="22" width="330" y="74" as="geometry" />
        </mxCell>
        <mxCell id="c242" parent="c238" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;tax_code&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">

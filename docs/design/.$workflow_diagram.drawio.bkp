="1" parent="1" source="q6" target="mD"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dFee" target="mD"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="272" y="1028" /><mxPoint x="272" y="1440" /></Array></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mD" target="q7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1485" /><mxPoint x="160" y="1485" /></Array></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7" target="dDo"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e26" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dDo" target="q8"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e27" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dDo" target="q9"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q8" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q9" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e30" value="⚡ ngắt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="evC" target="rC"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Được gọi từ luồng 07B, lặp lại được; xong thì quay lại 07B. Không mặc định từ chối mọi yêu cầu phát sinh, cũng không cho phép tuyệt đối: phân loại theo danh mục, loại dịch vụ, tình trạng BN và quy trình đã được đơn vị có thẩm quyền phê duyệt (Q-13). AI không được tự quyết một thuốc / thủ thuật là được phép.&lt;br&gt;• Trạng thái yêu cầu: Chờ đánh giá → Chờ phê duyệt → Được duyệt / Bị từ chối → Chờ BN xác nhận → Đã đồng ý / BN hủy → Đã thực hiện / Hủy. Phần việc cần phê duyệt không được chuyển 'Đã thực hiện' khi chưa 'Được duyệt' và (nếu có phí) chưa 'Đã đồng ý'.&lt;br&gt;• Nhánh C: vùng ngắt – dấu hiệu nguy hiểm dừng ngay mọi bước duyệt / xác nhận, chuyển luồng 17; ghi thời điểm phát hiện, cảnh báo và hành động.&lt;br&gt;• Tổng ca = dịch vụ gốc + Σ phát sinh 'Đã đồng ý' và 'Đã thực hiện' + vật tư − giảm trừ; cọc chỉ tính trên dịch vụ gốc; giá chốt lúc BN xác nhận; phí nền tảng (BR-05) tính cả phát sinh. Trần phát sinh 100% giá gốc; trần phần thu tiền mặt: Q-09.&lt;br&gt;• Không chặn lập trình khung luồng, &lt;b&gt;chặn go-live&lt;/b&gt;: danh mục A / B được phép tại nhà (Q-13), SLA người duyệt (Q-21)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2060" width="1200" height="170" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f08" name="08. Xác nhận, thanh toán sau ca &amp; xuất hóa đơn"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="2746" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 08. Xác nhận, thanh toán sau ca &amp;amp; xuất hóa đơn" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="2420.0" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="960" height="2420.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="960" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="2420.0" as="geometry" /></mxCell><mxCell id="lh2" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="2420.0" as="geometry" /></mxCell><mxCell id="lh3" value="Cổng thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="2420.0" as="geometry" /></mxCell><mxCell id="lh4" value="Quản trị BV / Hệ thống hóa đơn BV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1960" y="70" width="240" height="2420.0" as="geometry" /></mxCell><mxCell id="lh5" value="Admin nền tảng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1960" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="q0" value="Lập bảng kê ca: dịch vụ gốc, phát sinh 'đã thực hiện', vật tư – để BN xác nhận (UC93)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="220.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="q0b" value="Xem bảng kê tại chỗ (ĐD còn ở nhà): xác nhận rõ trên app hoặc đọc OTP cho ĐD (UC93), hoặc khiếu nại dòng. Im lặng 15 phút = xác nhận mặc định (chỉ để tính tiền, không cho thu tiền mặt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="305.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="qd0" value="Phản hồi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="qk0" value="Tách dòng bị khiếu nại; phần còn lại đi thanh toán ngay (thu tiền mặt chỉ khi BN xác nhận rõ các dòng còn lại)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="fk" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="546" width="1620" height="8" as="geometry" /></mxCell><mxCell id="q1" value="Tính tổng các dòng không bị khiếu nại; cọc phân bổ trước cho dòng bị khiếu nại (giữ lại), phần cọc còn lại trừ vào tổng này" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="613" width="196" height="74" as="geometry" /></mxCell><mxCell id="qk1" value="Đối chiếu bằng chứng; kết luận: giữ / giảm X / miễn dòng; quá 48h → nhắc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="620.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="qdg" value="Đã làm đủ dịch vụ gốc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="712" width="150" height="76" as="geometry" /></mxCell><mxCell id="qdr" value="Lý do?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="712" width="150" height="76" as="geometry" /></mxCell><mxCell id="qfree" value="Không tính dịch vụ gốc, không thu phí đến nhà (do ĐD / BV, cấp cứu y khoa, hoặc không an toàn cho ĐD – BV chịu); báo QT BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="720.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="qkd" value="Kết luận trong 5 ngày? (BR-18 F1)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1765" y="712" width="150" height="76" as="geometry" /></mxCell><mxCell id="qkm" value="BR-18 F1 – tự miễn dòng bị khiếu nại; BV chịu, ĐD vẫn tính thu nhập" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="qkad" value="BR-18 F1: Admin kết luận trong 3 ngày làm việc; quá hạn → giữ nguyên dòng tính tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1982" y="820.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="qmin" value="Tính phí đến nhà tối thiểu thay dịch vụ gốc (bảng giá BV). Mức phí: Q-03 – CHƯA CHỐT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="820.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="qda" value="Tổng − cọc còn lại &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="912" width="150" height="76" as="geometry" /></mxCell><mxCell id="qref" value="Phần cọc còn lại sau khi phân bổ → hoàn qua cổng; phần giữ cho dòng tranh chấp chờ chốt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="cDs" value="D" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="935" width="30" height="30" as="geometry" /></mxCell><mxCell id="cEt" value="E" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="935" width="30" height="30" as="geometry" /></mxCell><mxCell id="qk2" value="Còn phải thu sau khi trừ cọc đang giữ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1755" y="905" width="170" height="90" as="geometry" /></mxCell><mxCell id="qk4" value="Hoàn phần cọc còn dư (nếu có); xuất HĐĐT cho dòng tranh chấp theo số đã chốt, khấu trừ cọc đang giữ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="ek4" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="935" width="30" height="30" as="geometry" /></mxCell><mxCell id="qd1" value="Hình thức thanh toán?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="1012" width="150" height="76" as="geometry" /></mxCell><mxCell id="q2" value="Xử lý giao dịch, tiền về TK bệnh viện (UC46, UC47)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="1028" width="196" height="44" as="geometry" /></mxCell><mxCell id="qk3" value="Phần còn thiếu → 'Chờ thanh toán' (trả qua cổng trong 24h; quá hạn → 'Công nợ'); thu xong → xuất HĐĐT riêng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="1020.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="qd3" value="Thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="1112" width="150" height="76" as="geometry" /></mxCell><mxCell id="q8" value="Báo giao dịch thất bại (lần n / 3). Không thu tiền mặt ở bước này – muốn đổi sang tiền mặt phải chọn lại hình thức và qua ◇ điều kiện tiền mặt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1116" width="196" height="68" as="geometry" /></mxCell><mxCell id="cD2" value="D" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="1135" width="30" height="30" as="geometry" /></mxCell><mxCell id="ek3" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1825" y="1135" width="30" height="30" as="geometry" /></mxCell><mxCell id="qd8" value="BN thanh toán tiếp tại chỗ? (còn lượt cổng, hoặc chọn tiền mặt)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="1205" width="170" height="90" as="geometry" /></mxCell><mxCell id="qdebt" value="Không đủ điều kiện tiền mặt / hết lượt cổng / BN không trả → KHÔNG thu tiền mặt; đơn 'Chờ thanh toán': gửi link, BN trả qua cổng trong 24h (xuất HĐĐT khi thu); quá hạn → 'Công nợ', chặn đặt lịch mới &amp;amp; QT BV liên hệ. ĐD kết thúc ca, không giữ tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1208" width="196" height="108" as="geometry" /></mxCell><mxCell id="cEs" value="E" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="1335" width="30" height="30" as="geometry" /></mxCell><mxCell id="eqd" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="1335" width="30" height="30" as="geometry" /></mxCell><mxCell id="q3" value="Thu tiền mặt, nhập số tiền đã thu (UC122)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1328" width="196" height="44" as="geometry" /></mxCell><mxCell id="q4" value="Xác nhận số tiền đã trả cho ĐD (UC123)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1428" width="196" height="44" as="geometry" /></mxCell><mxCell id="qd2" value="Hai bên khớp số tiền?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="1512" width="150" height="76" as="geometry" /></mxCell><mxCell id="q5" value="Đơn 'tranh chấp tiền mặt'; báo QT BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1628" width="196" height="44" as="geometry" /></mxCell><mxCell id="q5b" value="Xác minh trong 24h (gọi hai bên, đối chiếu bảng kê); chốt số thực thu. ⏱ Quá hạn → BR-18 F5 – CHƯA CÓ MẶC ĐỊNH (Q-12)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="1613" width="196" height="74" as="geometry" /></mxCell><mxCell id="q6" value="Ghi tiền mặt ĐD giữ theo số đã khớp / đã chốt; BN còn thiếu → 'Chờ thanh toán' 24h → 'Công nợ'; hạn nộp 48h (luồng 10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1713" width="196" height="74" as="geometry" /></mxCell><mxCell id="q9" value="Đơn 'Đã thanh toán' (còn thiếu → 'Chờ thanh toán' 24h, quá hạn → 'Công nợ'; về 'Đã thanh toán' khi BN trả qua cổng); gửi phần đã thu sang hệ thống hóa đơn BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1813" width="196" height="74" as="geometry" /></mxCell><mxCell id="cDt" value="D" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="1835" width="30" height="30" as="geometry" /></mxCell><mxCell id="q10" value="Xuất HĐĐT cho các dòng đã thanh toán, khấu trừ cọc (UC126) – tự động; lỗi → QT BV xử lý. Thời điểm lập HĐ cho cọc: Q-11 – CHƯA CHỐT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="1913" width="196" height="74" as="geometry" /></mxCell><mxCell id="q11" value="Nhận hóa đơn; đánh giá ĐD (UC50)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="2028" width="196" height="44" as="geometry" /></mxCell><mxCell id="e" value=
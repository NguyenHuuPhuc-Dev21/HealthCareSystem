1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="bd5" target="e"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Đăng ký và đăng nhập chỉ bằng email; mọi OTP tài khoản gửi qua email, không dùng SMS. Không thu CCCD, nên nền tảng không xác minh tuổi hay quan hệ: hồ sơ người được chăm sóc do chủ tài khoản tự khai và chịu trách nhiệm (Q-51).&lt;br&gt;• Mỗi hồ sơ có consent riêng. Người thân là người lớn tự quyết định được → tự đồng ý qua link gửi tới email của họ; trẻ em / người không tự quyết định được → chủ tài khoản cam kết là người đại diện hợp pháp và đồng ý thay.&lt;br&gt;• Rút đồng ý (UC106) bất cứ lúc nào, xác nhận bằng OTP email: khóa đặt lịch mới cho hồ sơ; đơn chưa xuất phát → hủy, hoàn 100% cọc (luồng 09); ĐD đã xuất phát / đang trong ca → hoàn tất hoặc dừng giữa chừng (luồng 15); dữ liệu đã có → yêu cầu xóa (luồng 14).&lt;br&gt;• Không tự chuyển hồ sơ khi người được chăm sóc tròn 18 tuổi (không có dữ liệu tuổi đã xác minh). Người đó tự đăng ký tài khoản riêng; chủ tài khoản cũ gỡ liên kết hoặc yêu cầu xóa hồ sơ (luồng 14).&lt;br&gt;• Điều khoản mới → đồng ý lại khi đăng nhập / đặt lịch (luồng 03)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2210.0" width="900" height="86.0" as="geometry" /></mxCell><mxCell id="d8a" value="Người thân đồng ý trong 24h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="1405" width="150" height="76" as="geometry" /></mxCell><mxCell id="b8x" value="Không tạo hồ sơ; báo người tạo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1515" width="196" height="44" as="geometry" /></mxCell><mxCell id="e8x" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="1590" width="30" height="30" as="geometry" /></mxCell><mxCell id="x83a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8a" target="d8a"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8a" target="b8c"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1443" /><mxPoint x="520" y="1638" /><mxPoint x="400" y="1638" /></Array></mxGeometry></mxCell><mxCell id="x83c" value="Không / ⏱ 24h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8a" target="b8x"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8x" target="e8x"><mxGeometry x="0" relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f03" name="03. Đăng nhập &amp; phân quyền"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="1442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 03. Đăng nhập &amp;amp; phân quyền" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1190" as="geometry" /></mxCell><mxCell id="lh0" value="Người dùng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="1190" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="l1" value="Nhập email + mật khẩu (UC14)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="196" height="44" as="geometry" /></mxCell><mxCell id="ld0" value="Trạng thái tài khoản?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="312" width="150" height="76" as="geometry" /></mxCell><mxCell id="u0" value="Nhận thông báo theo trạng thái: khóa tạm (thử lại sau hh:mm) / bị vô hiệu / chưa kích hoạt – hướng dẫn liên hệ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="313" width="196" height="74" as="geometry" /></mxCell><mxCell id="e0" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="435" width="30" height="30" as="geometry" /></mxCell><mxCell id="ld2" value="Mật khẩu đúng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="s1" value="Tăng bộ đếm sai, ghi audit log (UC17)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="ld3" value="Sai đủ 5 lần (mật khẩu + mã 2 lớp)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="605" width="170" height="90" as="geometry" /></mxCell><mxCell id="u2" value="Nhận báo sai, đăng nhập lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="628" width="196" height="44" as="geometry" /></mxCell><mxCell id="s2" value="Khóa tài khoản 15 phút (UC15); báo chủ tài khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="e2" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="835" width="30" height="30" as="geometry" /></mxCell><mxCell id="ld4" value="Vai trò nhân sự (BS / ĐD / QT BV / Admin)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="405" width="170" height="90" as="geometry" /></mxCell><mxCell id="s3" value="Gửi và kiểm tra mã xác thực 2 lớp (qua email hoặc ứng dụng xác thực), hiệu lực 5 phút (UC83)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="ld5" value="Mã đúng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="612" width="150" height="76" as="geometry" /></mxCell><mxCell id="s4" value="Đặt lại bộ đếm sai; cấp phiên theo vai trò + bệnh viện (UC16); quyền kiểm tra lại ở backend cho từng yêu cầu; ghi audit log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="820.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="ld6" value="BN chưa đồng ý điều khoản / có phiên bản mới?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="905" width="170" height="90" as="geometry" /></mxCell><mxCell id="u5" value="Đọc và đồng ý điều khoản (UC138); không đồng ý → chỉ xem thông tin, đơn đã đặt chạy theo phiên bản cũ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="928" width="196" height="44" as="geometry" /></mxCell><mxCell id="u4" value="Vào trang chức năng theo vai trò" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1028" width="196" height="44" as="geometry" /></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="1135" width
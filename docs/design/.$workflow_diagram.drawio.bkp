dgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g9" target="g10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1408.0" /><mxPoint x="880" y="1408.0" /></Array></mxGeometry></mxCell><mxCell id="ed15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g10" target="gd4"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1485.0" /><mxPoint x="1120" y="1485.0" /></Array></mxGeometry></mxCell><mxCell id="ed16" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="gd4" target="g12"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g12" target="e12"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed18" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gd4" target="g11"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g11" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Luồng gồm 2 phần độc lập: (A) xử lý từng giao dịch theo thời gian thực; (B) đối chiếu cuối tháng.&lt;br&gt;• Mọi bệnh viện đều thu cọc qua cổng; tiền dịch vụ vào thẳng tài khoản bệnh viện, nền tảng không giữ tiền. Điều dưỡng xem bảng kê của mình (UC97).&lt;br&gt;• Các khoản hoàn tiền thủ công sau thanh toán (luồng 08, 12, 15) đối chiếu theo lệnh hoàn và chứng từ QT BV đã ghi.&lt;br&gt;• Đơn tiền mặt đối chiếu theo xác nhận thu của ĐD &amp;amp; BN và số thủ quỹ thực nhận (luồng 10).&lt;br&gt;• Đối soát cọc (BR-04): mỗi khoản cọc được tách theo số tiền vào đúng một trong bốn nhóm – (1) &lt;b&gt;đã khấu trừ&lt;/b&gt; vào thanh toán sau ca (luồng 08); (2) &lt;b&gt;đã hoàn&lt;/b&gt; toàn bộ / một phần (hủy theo bảng % ở luồng 09, phần cọc dư ở luồng 08); (3) &lt;b&gt;giữ lại, không hoàn&lt;/b&gt; theo BR-04 (phần không được hoàn khi hủy muộn, BN vắng nhà ở 07B – bù công ĐD; thời điểm lập hóa đơn: Q-11); (4) &lt;b&gt;đang giữ&lt;/b&gt; cho dòng tranh chấp chưa chốt. Tổng bốn nhóm phải bằng tổng cọc đã thu; lệch → mở đối soát chênh lệch." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1880.0" width="1200" height="144.0" as="geometry" /></mxCell><mxCell id="g4b" value="API lỗi / thiếu dữ liệu: tải sao kê từ cổng lên hệ thống để đối chiếu (UC111)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="713" width="196" height="74" as="geometry" /></mxCell><mxCell id="v8s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4b" target="gd2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="900.0" /><mxPoint x="400" y="900.0" /></Array></mxGeometry></mxCell><mxCell id="dApi" value="Lấy được sao kê qua API?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="792" width="150" height="76" as="geometry" /></mxCell><mxCell id="x83a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="dApi"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dApi" target="gd2"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83c" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dApi" target="g4b"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="830" /><mxPoint x="700" y="750" /></Array></mxGeometry></mxCell><mxCell id="gAd" value="Duyệt &amp;amp; phát hành hóa đơn phí nền tảng (UC95)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1220.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="x83d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g8" target="gAd"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gAd" target="g9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1300" /><mxPoint x="400" y="1300" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f12" name="12. Khiếu nại &amp; báo cáo hành vi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2072" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 12. Khiếu nại &amp;amp; báo cáo hành vi" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh0" value="Người khiếu nại (BN / ĐD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="1800.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh2" value="Quản trị bệnh viện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh3" value="Admin nền tảng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh4" value="Bên bị khiếu nại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="irg" value="Vùng ngắt: nhánh QT BV – hủy khi quá 5 ngày chưa kết luận" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=2;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="495" y="1013" width="965" height="297" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="k1" value="Gửi khiếu nại / báo cáo hành vi, đính kèm bằng chứng (UC51, UC101); sự cố tại nhà báo riêng (UC134)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="220.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="k2" value="Phân loại khiếu nại (UC52); kiểm tra hạn nộp 30 ngày sau khi kết thúc ca – quá hạn chỉ nhận nếu nghiêm trọng (BR-11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="313" width="196" height="74" as="geometry" /></mxCell><mxCell id="kd1" value="Về nền tảng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="522.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="k3" value="Xử lý khiếu nại về nền tảng, hạn 3 ngày làm việc (UC99)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="538.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="cRs" value="R" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1105" y="645.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="kd2" value="Nghiêm trọng (an toàn, bạo lực, quấy rối, gian lận)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305" y="605.0" width="190" height="110" as="geometry" /></mxCell><mxCell id="k4" value="Tạm khóa ngay: ĐD → khóa nhận ca, các đơn ĐD đã nhận chuyển luồng 06 (không xét vi phạm ở 06); BN → chặn đặt lịch mới, cảnh báo ĐD (UC98)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="615.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="k4b" value="Xác nhận giữ / gỡ tạm khóa trong 4 giờ; quá hạn → giữ khóa, nhắc &amp;amp; báo Admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="730.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="k5" value="Chuyển nguyên văn cho BV; hạn 3 ngày làm việc (BR-11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="838.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="956.0" width="1140" height="8" as="geometry" /></mxCell><mxCell id="tk" value="⏱ Quá 3 ngày làm việc chưa kết luận → nhắc BV (UC100); đến 5 ngày → kiểm tra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1023.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="kc" value="Xác minh, thu thập thông tin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1038.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="kr" value="Nhận thông báo; gửi giải trình trong 2 ngày (quá hạn → xử lý không cần giải trình)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1030.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="jb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="1156.0" width="660" height="8" as="geometry" /></mxCell><mxCell id="k6" value="Kết luận; kỷ luật nếu cần (UC53, UC79); quyết định bồi hoàn / giảm giá &amp;amp; bên chịu chi phí → QT BV hoàn tiền thủ công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1223.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="cRt" value="R" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="1245.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="k9" value="Trả kết quả cho hai bên; gỡ khóa nếu không có vi phạm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1338" width="196" height="44" as="geometry" /></mxCell><mxCell id="k10" value="Nhận kết quả xử lý (cả hai bên; bên bị khiếu nại cũng được phúc tra 1 lần theo cùng nhánh)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1430.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="kd4" value="Đồng ý kết quả?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="1522.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="1645.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="k11" value="Phúc tra 1 lần, hạn 5 ngày làm việc, người khác người kết luận lần đầu: QT BV kết luận → Admin; Admin xử lý thay khiếu nại về ĐD → Quản trị trưởng BV; khiếu nại về nền tảng → Admin khác (phân công luân phiên trong nhóm Admin). Quá hạn → giữ kết luận lần đầu, ghi báo cáo SLA tháng (BR-18 F4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1493.0" width="196" height="134" as="geometry" /></mxCell><mxCell id="k12" value="Kết luận cuối cùng (bồi hoàn nếu có → QT BV hoàn tiền thủ công); báo hai bên" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1638.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105" y="1745.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="k1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k1" target="k2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="308" /><mxPoint x="400" y="308" /></Array></mxGeometry></mxCell><mxCell id="ed3" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="kd1" target="k3"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.00
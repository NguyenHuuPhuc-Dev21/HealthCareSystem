"76" as="geometry" /></mxCell><mxCell id="rem" value="Báo ngay BN / người nhà: hướng dẫn gọi 115; báo bác sĩ trực và QT BV → luồng 17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="640.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="r2n" value="Gửi cảnh báo cho bác sĩ phụ trách / trực, đánh giá trong 2 giờ (UC55)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="740.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="866.0" width="900" height="8" as="geometry" /></mxCell><mxCell id="tmr" value="⏱ Quá 2h chưa đánh giá → nhắc bác sĩ (UC103); quá 4h → QT BV phân công bác sĩ khác, bác sĩ mới đánh giá tiếp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="940.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="r3n" value="Xem báo cáo &amp;amp; kết quả AI; đánh giá (UC68)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="948.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="rd2" value="Kết luận của bác sĩ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1132.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="rfa" value="Không cần tái khám: ghi nhận đánh giá, điều chỉnh mức rủi ro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1148.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="efa" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="1255.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="r2b" value="Gửi đề xuất tái khám (bác sĩ đã xác nhận) cho BN / NGH (UC56); nhắc sau 24h; rủi ro cao → gọi điện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1233.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="rd3" value="Đồng ý tái khám? (UC57)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="1325.0" width="170" height="90" as="geometry" /></mxCell><mxCell id="rref" value="Ghi nhận BN từ chối (đã được tư vấn); bác sĩ theo dõi ở các ca sau" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1340.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="eref" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="1455.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="r5n" value="Chọn BV tái khám; đồng ý cho bác sĩ BV đó xem lịch sử chăm sóc tại chính BV đó, có thời hạn (UC58, BR-09)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1433.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="r6n" value="Phân công bác sĩ phụ trách trong 24h (UC13); quá hạn → bác sĩ đã đánh giá cảnh báo nếu cùng BV tái khám; khác BV → nhắc QT BV &amp;amp; báo Admin (UC103)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1533.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="r7n" value="Cấp quyền xem lịch sử tại BV mình, có thời hạn (UC58)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1648.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="r8n" value="Xem lịch sử chăm sóc tại BV mình (UC59)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1748.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="r9n" value="Lập &amp;amp; duyệt kế hoạch tái khám (UC60)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1848.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="r10n" value="Nhận kế hoạch tái khám" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1948.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="2055.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="r1n"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1n" target="dai"><mxGeometry x="0" relative="1" as="geometry" /></mxCe
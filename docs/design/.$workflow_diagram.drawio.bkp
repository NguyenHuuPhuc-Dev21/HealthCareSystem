ock;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qdr" target="qmin"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed11" value="Do ĐD / BV / cấp cứu / không an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qdr" target="qfree"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qmin" target="qda"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="892" /><mxPoint x="400" y="892" /></Array></mxGeometry></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qfree" target="qda"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="750" /><mxPoint x="1000" y="892" /><mxPoint x="400" y="892" /></Array></mxGeometry></mxCell><mxCell id="ed14" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qdg" target="qda"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColo
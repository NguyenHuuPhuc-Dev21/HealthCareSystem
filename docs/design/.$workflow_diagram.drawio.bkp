ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd3" target="q8"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed32" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd3" target="cD2"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q8" target="qd8"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed34" value="Có – chọn lại hình thức" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd8" target="cEs"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed35" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd8" target="qdebt"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qdebt" target="eqd"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="q4"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1408" /><mxPoint x="160" y="1408" /></Array></mxGeometry></mxCell><mxCell id="ed39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="qd2"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed40" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd2" target="q5"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1550" /></Array></mxGeometry></mxCell><mxCell id="ed41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="q5b"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5b" target="q6"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="1693" /><mxPoint x="400" y="1693" /></Array></mxGeometry></mxCell><mxCell id="ed43" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd2" target="q6"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1693" /><mxPoint x="400" y="1693" /></Array></mxGeometry></mxCell><mxCell id="ed44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q6" target="q9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1808" /><mxPoint x="640" y="1808" /></Array></mxGeometry></mxCell><mxCell id="ed45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="cDt" target="q9"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q9" target="q10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1900.5" /><mxPoint x="1840" y="1900.5" /></Array></mxGeometry></mxCell><mxCell id="ed47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q10" target="q11"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="2008" /><mxPoint x="160" y="2008" /></Array></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Xác nhận bảng kê có hai mức (Q-33): &lt;b&gt;xác nhận rõ&lt;/b&gt; (BN bấm trên app hoặc đọc OTP cho ĐD) và &lt;b&gt;xác nhận mặc định&lt;/b&gt; (BN im lặng 15 phút). Xác nhận mặc định chỉ cho phép chốt số tiền và thanh toán qua cổng; &lt;b&gt;tiền mặt chỉ được thu khi có xác nhận rõ&lt;/b&gt;. Không có xác nhận rõ → ĐD không thu, đơn 'Chờ thanh toán' 24h, quá hạn → 'Công nợ'; không phát sinh tiền mặt ĐD giữ. BN vẫn được khiếu nại dòng trong 24 giờ; dòng đã trả → QT BV hoàn tiền thủ công.&lt;br&gt;• Dịch vụ gốc không làm được: lý do do BN / tình trạng BN → tính phí đến nhà tối thiểu (mức phí: Q-03 – chưa chốt, chặn); lý do do ĐD / BV (thiếu kỹ năng, thiếu dụng cụ…) hoặc cấp cứu y khoa → không thu gì cho dịch vụ gốc; dừng giữa chừng → BR-16. Lý do do ĐD chọn ở 07B; BN không đồng ý → khiếu nại dòng đó.&lt;br&gt;• Khiếu nại bảng kê xử lý nhanh tại QT BV, không qua luồng 12. Quá 5 ngày chưa kết luận: BN bình thường → tự miễn (BV chịu, ĐD vẫn tính thu nhập); BN có cờ lạm dụng (BR-19) → Admin kết luận trong 3 ngày làm việc, quá hạn → giữ nguyên dòng tính tiền.&lt;br&gt;• Thứ tự phân bổ cọc: trước hết giữ cho các dòng bị khiếu nại (tối đa bằng giá trị các dòng đó), phần còn lại trừ vào các dòng không tranh chấp; tranh chấp chốt xong mới hoàn phần cọc còn dư hoặc thu phần còn thiếu (BR-04).&lt;br&gt;• Thanh toán lỗi: hệ thống chỉ báo lỗi, không thu tiền. BN thanh toán tiếp → quay về Ⓔ chọn lại hình thức: qua cổng (tối đa 3 lần) hoặc tiền mặt. &lt;b&gt;Mọi đường tới 'Thu tiền mặt' đều đi qua ◇ 'Được thu tiền mặt?'&lt;/b&gt; (khối này là cạnh vào duy nhất). Không đủ điều kiện / hết lượt / BN không trả → không thu tiền mặt, 'Chờ thanh toán' 24h → 'Công nợ', chặn đặt lịch mới.&lt;br&gt;• Khiếu nại dòng tại chỗ không thay cho xác nhận: muốn thu tiền mặt phần còn lại, BN phải xác nhận rõ các dòng không tranh chấp (app / OTP); không có → thanh toán qua cổng (Q-33).&lt;br&gt;• Luồng có nhiều nhánh song song (tranh chấp dòng, khiếu nại sau thanh toán), nên mọi nhánh kết thúc bằng ⊗; luồng xong khi mọi nhánh xong.&lt;br&gt;• Tranh chấp tiền mặt: QT BV chốt số thực thu trong 24h; tiền ĐD giữ và hóa đơn theo số đã chốt.&lt;br&gt;• Tiền cọc: thời điểm lập hóa đơn chờ kế toán BV (Q-11 – chưa chốt, chặn). Điểm nối Ⓓ: sang bước 'Đã thanh toán'. Điểm nối Ⓔ: quay lại chọn hình thức thanh toán (tiền mặt vẫn qua ◇ điều kiện).&lt;br&gt;• Mốc, mặc định và bên chịu tiền khi quá hạn lấy từ bảng BR-18 (use_case_v8 trang 14), không định nghĩa lại ở đây.&lt;br&gt;• (1) Khiếu nại dòng trong 24h sau khi đã trả: QT BV xử lý như F1, kết luận giảm / miễn → QT BV hoàn tiền thủ công và xuất hóa đơn điều chỉnh; khiếu nại khác (chất lượng, hành vi) vẫn 30 ngày qua luồng 12 (BR-11). (2) Dòng tranh chấp được trả bằng cọc đang giữ cũng được xuất HĐĐT. (3) Một quy tắc trạng thái cho mọi khoản còn thiếu: 'Chờ thanh toán' (BN trả qua cổng trong 24h) → quá hạn → 'Công nợ' (chặn đặt lịch mới theo BR-14); xuất hóa đơn phần còn lại khi BN trả. (4) Dừng ca vì không an toàn / cấp cứu: không áp mốc 15 phút tại chỗ, BN xác nhận trong 24h.&lt;br&gt;• Khiếu nại dòng đã trả: QT BV quá 5 ngày không tự miễn (khác F1 trước thanh toán) mà chuyển Admin quyết – cần cập nhật BR-18 F1 trong use_case_v8 (Q-44)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2510.0" width="2160" height="230.0" as="geometry" /></mxCell><mxCell id="qstop" value="Dừng giữa chừng (luồng 15): phần đã xong tính đủ, phần dở dang theo BR-16 (phí tạm tính)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="820.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="v7e1" value="Dừng giữa chừng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qdr" target="qstop"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="640" y="800" /><mxPoint x="880" y="800" /></Array></mxGeometry></mxCell><mxCell id="v7e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qstop" target="qda"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="892" /><mxPoint x="400" y="892" /></Array></mxGeometry></mxCell><mxCell id="qlate" value="Mở khiếu nại dòng sau thanh toán; chuyển QT BV (không qua luồng 12)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="2108" width="196" height="74" as="geometry" /></mxCell><mxCell id="r09b" value="Giảm / miễn → QT BV hoàn tiền thủ công (qua cổng hoặc chuyển khoản), xuất hóa đơn điều chỉnh; ghi lệnh hoàn + chứng từ để đối soát (UC90, UC126)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="2246" width="196" height="59" as="geometry" /></mxCell><mxCell id="elate" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1585" y="2330" width="30" height="30" as="geometry" /></mxCell><mxCell id="dcash" value="Được thu tiền mặt? BN xác nhận rõ, ĐD còn tại chỗ, không dừng ca vì không an toàn / cấp cứu" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="1146" width="190" height="100" as="geometry" /></mxCell><mxCell id="x83a" value="Tiền mặt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qd1" target="dcash"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcash" target="q3"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1388" /><mxPoint x="1230" y="1388" /><mxPoint x="1230" y="1350" /></Array></mxGeometry></mxCell><mxCell id="d24" value="BN khiếu nại dòng đã trả trong 24h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="2100" width="170" height="90" as="geometry" /></mxCell><mxCell id="x83d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q11" target="d24"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83e" value="Không / ⏱ 24h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d24" target="e"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83f" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d24" target="qlate"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="qkl" value="Đối chiếu bằng chứng; kết luận giữ / giảm X / miễn trong 48h. Quá 5 ngày → Admin quyết trong 3 ngày làm việc; dòng đã trả KHÔNG tự miễn (F1 sửa – Q-44)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="2100" width="196" height="104" as="geometry" /></mxCell><mxCell id="x83g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="qlate" target="qkl"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="2145" /><mxPoint x="1700" y="2152" /></Array></mxGeometry></mxCell><mxCell id="dkl" value="Kết luận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1765" y="2230" width="150" height="76" as="geometry" /></mxCell><mxCell id="x83h" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qkl" target="dkl"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83i" value="Giảm / miễn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dkl" target="r09b"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83j" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r09b" target="elate"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="eKeep" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1825" y="2345" width="30" height="30" as="geometry" /></mxCell><mxCell id="x83k" value="Giữ nguyên – báo BN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dkl" target="eKeep"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x84a" value="Không – không thu tiền mặt" edge="1" parent="1" source="dcash" target="qdebt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="1196" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f09" name="09. Bệnh nhân hủy / đổi lịch &amp; hoàn cọc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 09. Bệnh nhân hủy / đổi lịch &amp;amp; hoàn cọc" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1990" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="960" height="1990" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="960" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="1990" as="geometry" /></mxCell><mxCell id="lh2" value="Quản trị bệnh viện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="1990" as="geometry" /></mxCell><mxCell id="lh3" value="Admin nền tảng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="1990" as="geometry" /></mxCell><mxCell id="lh4" value="Cổng thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="h1" value="Chọn hủy hoặc đổi lịch (UC34, UC120)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="196" height="44" as="geometry" /></mxCell><mxCell id="hd0" value="Đã đặt cọc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="h5" value="Đơn được hủy, slot / ĐD được nhả (chưa có cọc nên không hoàn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="e5" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="535" width="30" height="30" as="geometry" /></mxCell><mxCell id="hd1" value="Loại yêu cầu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="312" width="150" height="76" as="geometry" /></mxCell><mxCell id="hd2" value="Đặt trước, đã cọc, còn &amp;gt; 2h &amp;amp; đổi chưa quá 2 lần?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="405" width="170" height="90" as="geometry" /></mxCell><mxCell id="hno" value="Không đổi được. Chưa cọc → hủy &amp;amp; đặt lại; khác → BN có thể hủy theo chính sách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="eno" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="635" width="30" height="30" as="geometry" /></mxCell><mxCell id="h2" value="Chọn giờ mới (thỏa BR-13, BR-03, BR-14); kiểm tra lịch ĐD hiện tại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="hd3" value="ĐD trống &amp;amp; xác nhận trong 30 phút?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="505" width="170" height="90" as="geometry" /></mxCell><mxCell id="h3" value="Cập nhật đơn; chuyển cọc sang lịch mới; báo BN &amp;amp; ĐD; lên lịch lại 07A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="613" width="196" height="74" as="geometry" /></mxCell><mxCell id="e3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="735" width="30" height="30" as="geometry" /></mxCell><mxCell id="r04" value="▶ Luồng 04 điểm vào R (giữ nguyên cọc; giữ lịch &amp;amp; ĐD cũ tới khi ĐD mới xác nhận; không có ĐD → giữ lịch cũ hoặc hủy theo BR-04 tính từ giờ hẹn cũ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1022" y="513" width="196" height="74" as="geometry" /></mxCell><mxCell id="hdf" value="Đơn đang lỗi phía ĐD / BV? (đang thay người, quá giờ phải xuất phát chưa bấm &amp;#x27;Xuất phát&amp;#x27;, ĐD trễ quá mốc)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="590" width="200" height="120" as="geometry" /></mxCell><mxCell id="hpct" value="Tính % hoàn cọc (BR-04): đặt trước &amp;gt; 12h → 100%; 2–12h → 50%; &amp;lt; 2h hoặc ĐD đã bấm &amp;#x27;Xuất phát&amp;#x27; → 0%. Đặt ngay: ĐD chưa bấm &amp;#x27;Xuất phát&amp;#x27; → 100%; đã bấm → 0%" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="790" width="196" height="119" as="geometry" /></mxCell><mxCell id="hd6" value="% &amp;lt; 100% và BN xin ngoại lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="1005" width="170" height="90" as="geometry" /></mxCell><mxCell id="h8" value="Gửi lý do + minh chứng (UC36)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1128" width="196" height="44" as="geometry" /></mxCell><mxCell id="h9" value="Xem xét: duyệt → chốt % mới; từ chối → giữ % BR-04 (UC36); quá 24h → nhắc (BR-18 F2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1120.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="h9d" value="Xử lý trong 48h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285" y="1212" width="150" height="76" as="geometry" /></mxCell><mxCell id="h9a" value="Tự duyệt; BV chịu khoản bù công ĐD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1228" width="196" height="44" as="geometry" /></mxCell><mxCell id="h9ad" value="BR-18 F2: Admin quyết trong 3 ngày làm việc; quá hạn → giữ % theo BR-04" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="1328" width="196" height="44" as="geometry" /></mxCell><mxCell id="hd8" value="% hoàn &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor
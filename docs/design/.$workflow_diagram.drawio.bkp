=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aRej" target="cS1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e15" value="Cần bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="cS2"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e16" value="Duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="a7"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1000" /><mxPoint x="640" y="1000" /></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a7" target="a9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1112" /><mxPoint x="1120" y="1112" /></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a9" target="dact"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e19" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dact" target="ares"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ares" target="qres"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="qres" target="a7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1057" /></Array></mxGeometry></mxCell><mxCell id="e22" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dact" target="drole"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Điều dưỡng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="drole" target="a10"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e24" value="Bác sĩ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="drole" target="a10b"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a10" target="aOn"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1495" /><mxPoint x="400" y="1495" /></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a10b" target="aOn"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1565" /></Array></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="aOn" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Trạng thái hồ sơ: Bản nháp → Chờ BV xác nhận → Chờ nền tảng duyệt → Đã duyệt; nhánh phụ: Yêu cầu bổ sung (hạn 7 ngày) / Bị từ chối (được cập nhật lại thành phiên bản mới) / Hết hạn; sau khi hoạt động: Tạm khóa / Hết hạn CCHN / Ngừng hoạt động (Q-50).&lt;br&gt;• Phân vai: BV xác minh chuyên môn và chịu trách nhiệm tính xác thực; Admin nền tảng chỉ kiểm tra tính đầy đủ, trạng thái và điều kiện vận hành – nền tảng không tuyên bố đã chứng thực giấy phép hành nghề. AI không được phê duyệt hồ sơ hay kết luận ĐD đủ điều kiện.&lt;br&gt;• Mọi thay đổi ghi nhật ký kiểm toán: người thao tác, vai trò, thời gian, nội dung, phiên bản hồ sơ, quyết định, lý do. Điểm nối Ⓢ: quay về bước bổ sung.&lt;br&gt;• Hằng ngày quét hạn CCHN: trước 30 ngày nhắc nhân sự và QT BV; hết hạn → tự ngừng quyền nhận ca. Phát sinh vấn đề cần xác minh → QT BV / Admin tạm khóa quyền nhận ca. Nghỉ việc / chuyển khoa → QT BV khóa hoặc cập nhật (UC81). Tài khoản QT BV do Admin tạo khi BV ký hợp đồng (UC80).&lt;br&gt;• Số CCHN đang gắn tài khoản hoạt động ở BV khác → chặn (Q-01)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="1440" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f02" name="02. Đăng ký bệnh nhân &amp; tạo hồ sơ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="2356" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 02. Đăng ký bệnh nhân &amp;amp; tạo hồ sơ" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="2120.0" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="2120.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="b1" value="Nhập email đăng ký (UC1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="196" height="44" as="geometry" /></mxCell><mxCell id="dx" value="Email đã có tài khoản?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="305" width="170" height="90" as="geometry" /></mxCell><mxCell id="bx" value="Nhận thông báo; chuyển sang đăng nhập / quên mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="328" width="196" height="44" as="geometry" /></mxCell><mxCell id="ex" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="435" width="30" height="30" as="geometry" /></mxCell><mxCell id="b2" value="Gửi OTP qua email (hiệu lực 5 phút, cho gửi lại sau 60 giây)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="b3" value="Nhập OTP từ email (có thể yêu cầu gửi lại)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="bd1" value="OTP đúng &amp;amp; còn hạn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="612" width="150" height="76" as="geometry" /></mxCell><mxCell id="bc" value="Tăng số lần nhập sai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="628" width="196" height="44" as="geometry" /></mxCell><mxCell id="bdc" value="Sai đủ 3 lần?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="712" width="150" height="76" as="geometry" /></mxCell><mxCell id="bl" value="Khóa đăng ký email này 15 phút" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="828" width="196" height="44" as="geometry" /></mxCell><mxCell id="el" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="935" width="30" height="30" as="geometry" /></mxCell><mxCell id="b4" value="Đặt mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="b5" value="Đọc &amp;amp; đồng ý xử lý dữ liệu sức khỏe (UC2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="828" width="196" height="44" as="geometry" /></mxCell><mxCell id="bd2" value="Đồng ý?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="912" width="150" height="76" as="geometry" /></mxCell><mxCell id="bnc" value="Tài khoản 'chưa đồng ý': chỉ xem thông tin; hỏi lại khi đăng nhập / đặt lịch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="enc" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="1035" width="30" height="30" as="geometry" /></mxCell><mxCell id="b6" value="Lưu consent kèm phiên 
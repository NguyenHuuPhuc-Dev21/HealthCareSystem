exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="n9"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.864;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="tm"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="tm" target="etm"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1418.0" /><mxPoint x="1360" y="1418.0" /></Array></mxGeometry></mxCell><mxCell id="ed22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="nd3"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1502.0" /><mxPoint x="400" y="1502.0" /></Array></mxGeometry></mxCell><mxCell id="ed23" value="Thất bại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="nd3" target="n9b"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9b" target="n9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="47" y="1560.0" /><mxPoint x="47" y="1360.0" /></Array></mxGeometry></mxCell><mxCell id="ed25" value="Thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="nd3" target="n12"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Đặt ngay không có chức năng từ chối: ĐD tự bật / tắt &quot;Đang rảnh&quot;; đang bật nghĩa là sẵn sàng nhận đơn, hệ thống tự gán.&lt;br&gt;• ĐD bấm &quot;Đã nhận đơn&quot; để xác nhận đã thấy thông báo. Quá 5 phút → gỡ gán và tự tắt &quot;Đang rảnh&quot; (để không gán tiếp cho người không cầm máy); lần đầu không ghi vi phạm, lặp lại 3 lần trong 30 ngày cuộn mới ghi 1 vi phạm; ghi xong trừ 3 lần đó khỏi bộ đếm, không đếm chồng (BR-01, Q-29).&lt;br&gt;• Giới hạn ghép: tổng 15 phút kể từ khi bắt đầu tìm (tương đương tối đa 3 lần gán × 5 phút). Hết 15 phút → báo BN không có ĐD.&lt;br&gt;• Giờ phải xuất phát (mốc của bộ hẹn giờ bom ca ở 07B) = lúc BN cọc xong + 10 phút chuẩn bị; ETA = giờ phải xuất phát + thời gian di chuyển ước tính từ vị trí ĐD lúc đó. Không tính lúc gán, vì ĐD chỉ xuất phát sau khi có cọc.&lt;br&gt;• ĐD đã nhận nhưng phát sinh sự cố không đi được → báo nghỉ đột xuất (luồng 06), xử lý vi phạm theo BR-02.&lt;br&gt;• Không tự chuyển sang cơ sở khác khi hết điều dưỡng. Đơn đặt ngay không đi qua luồng 07A.&lt;br&gt;• 'ĐD chưa đi' (điều kiện hoàn 100% khi hủy đặt ngay) = ĐD chưa bấm 'Xuất phát' trên hệ thống (BR-04).&lt;br&gt;• ĐD đã bấm 'Đã nhận đơn' rồi bấm 'Hủy nhận' trong 5 phút và trước khi BN cọc → ghi ngay 1 vi phạm (BR-01, Q-41), hủy chờ cọc, mở lượt ghép mới 15 phút; sau mốc đó → báo không đi được (luồng 06).&lt;br&gt;• Hủy đặt ngay: ĐD chưa bấm 'Xuất phát' → hoàn 100%, đã bấm → 0% (BR-04, Q-38)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1890.0" width="1440" height="178.0" as="geometry" /></mxCell><mxCell id="n7b" value="Gỡ gán, tắt 'Đang rảnh', ghi 1 vi phạm (BR-01, Q-41); hủy chờ cọc &amp;amp; bộ hẹn giờ cọc; mở lượt ghép mới (giới hạn 15 phút tính lại – Q-45)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1072" width="196" height="89" as="geometry" /></mxCell><mxCell id="cGs" value="G" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1105" y="1172" width="30" height="30" as="geometry" /></mxCell><mxCell id="cGt" value="G" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="585" width="30" height="30" as="geometry" /></mxCell><mxCell id="v8g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7b" target="cGs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cGt" target="nd1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="650" /></Array></mxGeometry></mxCell><mxCell id="evW" value="⚡ Sự kiện: ĐD bấm 'Hủy nhận' (≤ 5 phút sau 'Đã nhận đơn', BN chưa cọc)" style="shape=step;perimeter=stepPerimeter;flipH=1;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1290" width="196" height="56" as="geometry" /></mxCell><mxCell id="x83a" value="⚡ ngắt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evW" target="n7b"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="1318" /><mxPoint x="1010" y="1117" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f06" name="06. Điều dưỡng báo nghỉ / đổi người – tìm người thay"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2584" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 06. Điều dưỡng báo nghỉ / đổi người – tìm người thay" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="2200.0" as="geometry" /></mxCell><mxCell id="lh0" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="720" height="2200.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="720" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="480" height="2200.0" as="geometry" /></mxCell><mxCell id="lh2" value="Quản trị bệnh viện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="2200.0" as="geometry" /></mxCell><mxCell id="lh3" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="2200.0" as="geometry" /></mxCell><mxCell id="lh4" value="Điều dưỡng thay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="rg06" value="Vùng ngắt: tìm người thay có mời – thoát khi có ĐD thay nhận (⚡ hủy ⏱) hoặc ⏱ T−1h (⚡ sang ghép nhanh)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=2;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="292" y="1200" width="1660" height="505" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="t1" value="Điểm vào: ĐD báo nghỉ (UC116) / BN đổi người hoặc hủy khi ĐD trễ, bom ca (07B) / ĐD trễ quá mốc nhưng vẫn phục vụ (07B) / ĐD bị tạm khóa do khiếu nại (12) / ĐD dừng ca vì lý do phía ĐD (15)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="205.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="t2" value="Ghi nhận; báo QT BV. Cần thay người → đơn &amp;#x27;đang thay người&amp;#x27;, nhả lịch ĐD cũ; BN đã hủy → giữ &amp;#x27;đã hủy&amp;#x27;; đã phục vụ xong → giữ trạng thái hiện tại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="313" width="196" height="74" as="geometry" /></mxCell><mxCell id="fb1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="446" width="900" height="8" as="geometry" /></mxCell><mxCell id="td0" value="Đặt trước &amp;amp; còn &amp;gt; 1h đến giờ hẹn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="615.0" width="170" height="90" as="geometry" /></mxCell><mxCell id="t5n" value="Ghép nhanh như luồng 05 (ĐD &amp;#x27;Đang rảnh&amp;#x27;, kịp di chuyển; loại ĐD cũ); tối đa 15 phút; giữ nguyên cọc (đơn từ 15: tạo đơn con cho phần còn lại, không cọc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="623.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="cQt" value="Q" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="645.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="tsrc" value="Nguồn vào?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="622.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="tk12" value="Không xét vi phạm ở đây – theo kết luận luồng 12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="638.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="t3" value="Xác định lý do &amp;amp; xét vi phạm một lần cho đơn (UC88), hạn 24h; quá hạn → nhắc (BR-18 F6). ⏱ ĐD đang bị tạm khóa do bom ca: quá 24h chưa xác nhận → tự mở khóa, vi phạm vẫn xét tới 72h (Q-43)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="715.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="td5q" value="Có ĐD nhận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="722.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="t5x" value="Hủy đơn; hoàn 100% cọc (UC90); báo BN (đơn con từ 15: chỉ hủy đơn con, không có cọc để hoàn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="738.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="etk12" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="745.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="tdbk" value="Bất khả kháng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="822.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="tok" value="Không ghi vi phạm; mở tạm khóa nhận ca (nếu có)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="838.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="etok" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="945.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t5b" value="Báo BN ĐD mới &amp;amp; ETA mới; BN chọn chờ hoặc hủy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="838.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e5x" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="845.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t4" value="Ghi 1 vi phạm theo loại (báo nghỉ / trễ / bom ca – BR-02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="938.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e4" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105" y="1045.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="td5b" value="BN chọn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="922.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="t5h" value="Hủy; hoàn 100% cọc (UC90); nhả ĐD mới (đơn con từ 15: chỉ hủy đơn con)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="938.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="r07b" value="▶ Luồng 07B – mốc trễ tính theo ETA mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="542" y="1038.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e5h" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="1045.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="fb2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="1156.0" width="660" height="8" as="geometry" /></mxCell><mxCell id="cAt" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="1245.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t6" value="Lấy ứng viên: &amp;gt; 3h → theo lịch trống; ≤ 3h → 'Đang rảnh' &amp;amp; kịp di chuyển; lọc kỹ năng, vùng, giới tính mong muốn; AI xếp hạng; loại người đã từ chối (UC37)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1215.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="cQs" value="Q" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="1380" width="30" height="30" as="geometry" /></mxCell><mxCell id="tmr" value="⏱ Đến T−1h mà vùng còn chạy (chưa có ĐD thay nhận ca)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1230.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="td3" value="Còn ứng viên?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="1322.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="t8" value="Điều người thủ công (UC78)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1338.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="td4" value="Tìm được?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1422.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="etd4" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="1445.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t7" value="Mời ĐD thay (hạn 30 phút; còn ≤ 3h: 5 phút)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1438.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="t7b" value="Xem &amp;amp; phản hồi lời mời thay ca" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1742" y="1538.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="td6" value="Phản hồi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1765" y="1622.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="cAs" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1585" y="1645.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t10" value="Đề xuất người thay (đã nhận, đang giữ chỗ) cho BN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1738.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="t11" value="Chọn trong 15 phút (còn &amp;gt; 3h: 30 phút): đồng ý / ĐD khác / đổi giờ / hủy (UC117)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="1830.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="td5" value="Lựa chọn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1525" y="1922.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="t12" value="Gán người thay; báo ĐD mới; ghi bàn giao (người giao, người nhận, nội dung). Đơn đang ở 07A → ▶ 07A điểm vào J; chưa tới 07A → 07A từ đầu (bỏ qua bước ĐD xác nhận lại)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1930.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="e12" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="2045.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t13" value="Chọn ĐD khác (chỉ khi còn ≥ 2h): nhả giữ chỗ người thay; ▶ luồng 04 điểm vào R (giữ nguyên cọc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502" y="2023.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="e13" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1585" y="2145.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="t14" value="Đổi giờ: nhả giữ chỗ người thay; chuyển cọc sang lịch mới → luồng 04 điểm vào R (luồng 09, miễn điều kiện thời gian). Hủy: hoàn 100% cọc (UC90)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="2023" width="196" height="74" as="geometry" /></mxCell><mxCell id="e14" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="2045" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="t1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="t2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="300.5" /><mxPoint x="400" y="300.5" /></Array></mxGeometry></mxCell><mxCell id="ed2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.100;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="fb1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.100;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb1" target="tneed"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.900;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb1" target="tsrc"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed5" value="Từ luồng 12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="tsrc" target="tk12"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk12" target="etk12"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed7" value="Khác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="tsrc" target="t3"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="
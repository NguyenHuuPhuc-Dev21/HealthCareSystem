xCell id="title" value="Luồng 05. Đặt ngay – ghép nhanh" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="720" height="1800.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="720" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh2" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="1800.0" as="geometry" /></mxCell><mxCell id="lh3" value="Cổng thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="rgW" value="Vùng ngắt: chờ BN cọc" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=2;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="42" y="1270" width="1428" height="340" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="n1" value="Chọn 'Đặt ngay': hồ sơ, cơ sở, dịch vụ, địa chỉ; giới tính ĐD mong muốn – tùy chọn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="220.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="n2" value="Kiểm tra khung giờ (BR-03), vùng phục vụ, consent, công nợ &amp;amp; lịch trùng (BR-14); dịch vụ cần y lệnh phải có chỉ định còn hiệu lực (BR-15); sàng lọc 4 nhóm như luồng 04" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="305.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="nd0" value="Kết quả kiểm tra?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="n0" value="Đơn bị chặn; nhận hướng dẫn gọi 115, nút SOS (luồng 17)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="e0" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="535" width="30" height="30" as="geometry" /></mxCell><mxCell id="n0b" value="Báo lý do (ngoài giờ / ngoài vùng / chưa phân loại được); BN chỉnh lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="420.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="n3" value="Lọc ĐD 'Đã duyệt' và đủ điều kiện nhận ca, 'Đang rảnh', đúng kỹ năng, giới tính, kịp di chuyển; AI xếp hạng; loại người vừa bị gỡ gán (UC24, UC25)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="513" width="196" height="74" as="geometry" /></mxCell><mxCell id="nd1" value="Còn ứng viên &amp;amp; tổng thời gian ghép &amp;lt; 15 phút?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="605" width="170" height="90" as="geometry" /></mxCell><mxCell id="n4" value="Nhận thông báo không có ĐD; gợi ý đặt hẹn trước (UC87)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="628" width="196" height="44" as="geometry" /></mxCell><mxCell id="e4" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="735" width="30" height="30" as="geometry" /></mxCell><mxCell id="n5" value="Tự động gán ĐD xếp hạng cao nhất; chuyển ĐD sang 'Đang bận'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="n6" value="Nhận thông báo được gán đơn (UC30) – không có nút từ chối" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="828" width="196" height="44" as="geometry" /></mxCell><mxCell id="nd2" value="Bấm 'Đã nhận đơn' trong 5 phút? (UC31)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="905" width="170" height="90" as="geometry" /></mxCell><mxCell id="n7" value="Gỡ gán; tự tắt 'Đang rảnh' của ĐD; ghi vi phạm chỉ khi lặp lại (3 lần / 30 ngày cuộn – BR-01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="n8" value="Báo BN thông tin ĐD được gán; chờ BN cọc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1028" width="196" height="44" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="1256.0" width="660" height="8" as="geometry" /></mxCell><mxCell id="n9" value="Đặt cọc 30% qua cổng (UC45)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1338.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="tm" value="⏱ Hết 15 phút chưa cọc thành công → hủy đơn, trả ĐD về 'Đang rảnh'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1330.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="etm" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="1445.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="n10" value="Xử lý giao dịch cọc (UC46, UC47)" style="rounded=1;whi
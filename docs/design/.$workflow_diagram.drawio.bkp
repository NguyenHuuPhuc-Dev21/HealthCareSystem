lue="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld2" target="ld4"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed12" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld4" target="s3"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="ld5"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed14" value="Sai" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld5" target="s1"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="531.5" y="650" /><mxPoint x="531.5" y="550" /></Array></mxGeometry></mxCell><mxCell id="ed15" value="Đúng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld5" target="s4"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed16" value="Không (bệnh nhân)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld4" target="s4"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="753" y="450" /><mxPoint x="753" y="850" /></Array></mxGeometry></mxCell><mxCell id="ed17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="ld6"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed18" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld6" target="u5"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed19" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ld6" target="u4"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1008" /><mxPoint x="160" y="1008" /></Array></mxGeometry></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="u5" target="u4"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="u4" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Quên mật khẩu: nhập email → nhận mã đặt lại qua email (hết hạn sau 15 phút) → đặt mật khẩu mới (UC82).&lt;br&gt;• Phân quyền kiểm tra ở backend và tầng truy vấn, không chỉ ẩn nút ở frontend; không tin ID do frontend gửi. Quyền tối thiểu = vai trò + quan hệ với BN + ca / hồ sơ cụ thể + mục đích và trạng thái nghiệp vụ: BN xem hồ sơ của mình và dữ liệu được chia sẻ; ĐD chỉ xem hồ sơ cần cho ca được phân công, trong thời gian ca; QT BV chỉ dữ liệu BV mình (BR-09); Admin nền tảng chỉ dữ liệu vận hành, không mặc định xem nội dung sức khỏe. Ghi nhật ký truy cập (ai, lúc nào, hồ sơ nào, hành động); không ghi mật khẩu, token, nội dung sức khỏe thừa vào log.&lt;br&gt;• Điều dưỡng được thêm vào nhóm bắt buộc xác thực 2 lớp vì truy cập địa chỉ, dữ liệu sức khỏe và giữ tiền mặt (đã có trong UC83 từ use_case_v5).&lt;br&gt;• Điều khoản mới: thay đổi trọng yếu → hỏi đồng ý lại ở bước này; không trọng yếu → chỉ thông báo, coi như tiếp tục đồng ý (Q-47).&lt;br&gt;• Bộ đếm sai dùng chung cho mật khẩu và mã 2 lớp; đăng nhập thành công thì đặt lại bộ đếm." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="900" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f04" name="04. Đặt lịch hẹn trước – bệnh nhân chọn điều dưỡng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3516" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 04. Đặt lịch hẹn trước – bệnh nhân chọn điều dưỡng" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="3110.0" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="3110.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="3110.0" as="geometry" /></mxCell><mxCell id="lh2" value="Hệ thống AI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="3110.0" as="geometry" /></mxCell><mxCell id="lh3" value="Bác sĩ trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="3110.0" as="geometry" /></mxCell><mxCell id="lh4" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="3110.0" as="geometry" /></mxCell><mxCell id="lh5" value="Cổng thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="c1n" value="Chọn hồ sơ, cơ sở, dịch vụ, địa chỉ, ngày giờ hẹn; giới tính ĐD mong muốn – tùy chọn (UC18, UC84)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="213" width="196" height="74" as="geometry" /></mxCell><mxCell id="c2n" value="Kiểm tra: ≥ 2h &amp;amp; ≤ 14 ngày (BR-13), khung giờ (BR-03), vùng phục vụ (BR-06), consent hồ sơ; không có công nợ quá hạn, không trùng giờ, ≤ 3 lịch chưa xong / hồ sơ (BR-14)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="298" width="196" height="104" as="geometry" /></mxCell><mxCell id="cd1" value="Hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="c3n" value="Nhập triệu chứng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="c4n" value="Phân loại triệu chứng (UC21)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="628" width="196" height="44" as="geometry" /></mxCell><mxCell id="cd2" value="AI trả kết quả rõ ràng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="712" width="150" height="76" as="geometry" /></mxCell><mxCell id="c5n" value="Phân loại thủ công (UC23), hạn 10 phút" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="cd2b" value="Xong trong 10 phút?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="812" width="150" height="76" as="geometry" /></mxCell><mxCell id="c5x" value="Báo BN chưa phân loại được: thử lại sau; khẩn cấp: gọi 115 / nút SOS (luồng 17)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="828" width="196" height="44" as="geometry" /></mxCell><mxCell id="ex5" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="935" width="30" height="30" as="geometry" /></mxCell><mxCell id="cd6" value="Kết quả sàng lọc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="912" width="150" height="76" as="geometry" /></mxCell><mxCell id="c7n" value="Đơn bị chặn; hướng dẫn gọi 115 ngay, nút SOS (luồng 17) (UC20)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="928" width="196" height="44" as="geometry" /></mxCell><mxCell id="e7" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="1035" width="30" height="30" as="geometry" /></mxCell><mxCell id="c8n" value="Xem kết quả và giới hạn của sàng lọc; nhóm &quot;cần đánh giá sớm&quot; → bác sĩ trực gọi lại trước giờ hẹn; chỉ được bổ sung triệu chứng, không tự hạ mức (UC22)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1120.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="cd7" value="Bổ sung triệu chứng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="1212" width="150" height="76" as="geometry" /></mxCell><mxCell id="c9n" value="Tính phí (UC26); lọc ĐD có lịch trống, đúng kỹ năng, giới tính, trong vùng; loại người đã từ chối (UC24)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1613.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="cd8" value="Có ĐD phù hợp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="1712.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="c9x" value="Báo không có ĐD phù hợp; gợi ý khung giờ / cơ sở khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1728.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="ex9" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" pare
ontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p14" target="pd5"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed23" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd5" target="r07c"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed24" value="lặp lại được" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="r07c" target="pd5"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1300" /><mxPoint x="970" y="1300" /><mxPoint x="970" y="1260" /></Array></mxGeometry></mxCell><mxCell id="ed25" value="Không / đã xong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd5" target="p16"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.864;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16" target="fb"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.136;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="r08"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="trep"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.864;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="p17"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="trep" target="etrep"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1560" /><mxPoint x="520" y="1660" /></Array></mxGeometry></mxCell><mxCell id="ed32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Điểm vào: từ luồng 07A (đơn đặt trước), luồng 05 (đơn đặt ngay) hoặc luồng 06 sau khi thay người.&lt;br&gt;• Giờ phải xuất phát: đặt trước = giờ hẹn − thời gian di chuyển ước tính (tính lại lúc T−1h theo vị trí ĐD); đặt ngay = lúc BN cọc xong + 10 phút chuẩn bị; sau thay người = lúc gán + 10 phút. ETA = giờ phải xuất phát + thời gian di chuyển ước tính (đặt trước: ETA = giờ hẹn).&lt;br&gt;• Mốc trễ = ETA + 15 phút. Bom ca là sự kiện ⚡ ngắt vùng &amp;quot;ĐD trên đường tới&amp;quot; (từ lúc sẵn sàng đến khi check-in): mọi việc trong vùng dừng, đơn sang luồng 06. Bom ca và trễ chỉ tạm khóa / ghi nhận; vi phạm được xét một lần duy nhất ở luồng 06 (có xét bất khả kháng).&lt;br&gt;• Khi ĐD trễ: BN chờ tiếp tối đa 2 lần (mỗi lần 15 phút). BN không phản hồi 5 phút → coi như chờ tiếp; hết 2 lần mà vẫn trễ → tự chuyển đổi người (luồng 06). Mọi phương án hủy ở đây đều hoàn 100% cọc.&lt;br&gt;• Lý do dịch vụ gốc không làm được (ĐD chọn khi kết thúc ca) quyết định cách tính phí ở luồng 08.&lt;br&gt;• Trong ca, ĐD có thể bấm SOS (UC92) → báo bác sĩ trực &amp;amp; QT BV, kèm hướng dẫn gọi 115. Thanh toán (luồng 08) chạy ngay khi kết thúc ca, không chờ báo cáo.&lt;br&gt;• Điểm nối Ⓑ: quay lại kiểm tra mốc trễ với mốc mới.&lt;br&gt;• Đã bắt đầu chăm sóc mà phải dừng (cấp cứu, không an toàn, BN yêu cầu…) → luồng 15. BN và ĐD liên lạc qua chat / gọi trong app (UC133) – nền tảng không yêu cầu SĐT.&lt;br&gt;• ĐD trễ quá mốc nhưng BN chờ và ca vẫn diễn ra → vẫn sang luồng 06 để QT BV xét vi phạm trễ (trước đây vi phạm này không bao giờ được xét). 'Dịch vụ gốc không làm được' chỉ dùng khi chưa làm hạng mục nào; đã làm dở → luồng 15 (BR-16).&lt;br&gt;• Hai mốc khác nhau: 'Đã kết thúc' (ĐD bấm kết thúc, thanh toán chạy ngay) và 'Hoàn tất' (chỉ khi báo cáo đủ trường bắt buộc theo loại dịch vụ). Ngoại lệ không cần đủ báo cáo: không có. Biểu mẫu theo loại dịch vụ do chuyên môn phê duyệt (Q-49), không bắt một bộ trường chung cho mọi dịch vụ. Sửa báo cáo lưu người sửa, thời gian, lý do.&lt;br&gt;• Lý do chọn ở bước kết thúc ca quyết định phí ở luồng 08; lý do do BN / tình trạng BN → phí đến nhà tối thiểu, mức phí chưa chốt (Q-03 – chặn).&lt;br&gt;• Sự kiện bom ca chỉ có hiệu lực khi đơn còn ở trạng thái 'ĐD đang tới' của chính ĐD này. Rời vùng (check-in, đổi người, hủy, BN vắng) → sự kiện hết hiệu lực: tắt định vị trong lúc chăm sóc hoặc ĐD cũ sau khi đã đổi người không tạo bom ca." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1990.0" width="960" height="220.0" as="geometry" /></mxCell><mxCell id="r15" value="▶ Luồng 15: dừng ca giữa chừng (UC127)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="62" y="1130.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="r06t" value="▶ Luồng 06: QT BV xét vi phạm trễ (không tìm người thay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="42" y="1636" width="176" height="59" as="geometry" /></mxCell><mxCell id="e06t" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="115" y="1720" width="30" height="30" as="geometry" /></mxCell><mxCell id="ev15" value="⚡ Sự kiện: cần dừng giữa chừng (đã làm ≥ 1 hạng mục dịch vụ gốc, trước khi ĐD bấm kết thúc ca)" style="shape=step;perimeter=stepPerimeter;flipH=1;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1131" width="196" height="59" as="geometry" /></mxCell><mxCell id="x83a" value="⚡ ngắt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev15" target="r15"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="dLate" value="ĐD đã trễ quá mốc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1530" width="120" height="76" as="geometry" /></mxCell><mxCell id="eLate" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="228" y="1553" width="30" height="30" as="geometry" /></mxCell><mxCell id="x83b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="dLate"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="1505" /><mxPoint x="130" y="1505" /></Array></mxGeometry></mxCell><mxCell id="x83c" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dLate" target="r06t"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83d" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dLate" target="eLate"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r06t" target="e06t"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="evBom" value="⚡ Sự kiện: bom ca – chỉ khi ĐD này còn đang tới (trước check-in): quá giờ phải xuất phát 10 phút chưa di chuyển, hoặc tắt định vị &amp;gt; 10 phút" style="shape=step;perimeter=stepPerimeter;flipH=1;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="306" width="196" height="88" as="geometry" /></mxCell><mxCell id="x87a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="p7"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x87b" value="⚡ ngắt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evBom" target="rbom"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="dRep" value="Đủ trường bắt buộc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="1612" width="150" height="76" as="geometry" /></mxCell><mxCell id="pMiss" value="Hiển thị trường còn thiếu; ca 'Chờ hoàn thiện báo cáo'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1620" width="196" height="59" as="geometry" /></mxCell><mxCell id="x89a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17" target="dRep"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x89b" value="Thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dRep" target="pMiss"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x89c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pMiss" target="p17"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1605" /><mxPoint x="765" y="1605" /><mxPoint x="765" y="1560" /></Array></mxGeometry></mxCell><mxCell id="x89d" value="Đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dRep" target="p18"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1712" /><mxPoint x="640" y="1712" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f07c" name="07C. Dịch vụ phát sinh trong ca"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="2290" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 07C. Dịch vụ phát sinh trong ca – nhánh A (được phép) / B (cần đánh giá, phê duyệt) / C (nguy hiểm)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1970" as="geometry" /></mxCell><mxCell id="lh0" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="1970" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="1970" as="geometry" /></mxCell><mxCell id="lh2" value="Bác sĩ trực / người có thẩm quyền" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1970" as="geometry" /></mxCell><mxCell id="lh3" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="rg" value="Vùng ngắt: xử lý yêu cầu phát sinh – dấu hiệu nguy hiểm xuất hiện bất kỳ lúc nào thì dừng ngay" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=2;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="48" y="195" width="1184" height="1590" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="q0" value="BN / người nhà đề nghị thêm (hoặc ĐD đề xuất); ĐD chọn dịch vụ / vật tư từ bảng giá của cơ sở – không nhập giá tự do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="205" width="196" height="89" as="geometry" /></mxCell><mxCell id="q2" value="Phân loại theo danh mục đã được phê duyệt (BR-15, Q-13): phạm vi hành nghề ĐD, kỹ năng, kế hoạch chăm sóc, trần phát sinh, lịch ca kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="305" width="196" height="89" as="geometry" /></mxCell><mxCell id="dCls" value="Phân loại?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="422" width="150" height="76" as="geometry" /></mxCell><mxCell id="qX" value="Không làm trong ca (ngoài danh mục / vượt trần / ngoài kỹ năng); báo lý do, gợi ý đặt đơn mới hoặc khám tại BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="415" width="196" height="89" as="geometry" /></mxCell><mxCell id="eX" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="540" width="30" height="30" as="geometry" /></mxCell><mxCell id="qB1" value="Nhánh B: tạo yêu cầu phát sinh 'Chờ đánh giá'; chuyển đúng người có thẩm quyền theo danh mục" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="513" width="196" height="74" as="geometry" /></mxCell><mxCell id="qA1" value="Nhánh A: kiểm tra điều kiện thực hiện và chống chỉ định theo quy trình đã phê duyệt (checklist)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="613" width="196" height="74" as="geometry" /></mxCell><mxCell id="qB2" value="Đánh giá / chỉ định / phê duyệt ('Chờ phê duyệt'), hạn 10 phút (UC137)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="613" width="196" height="74" as="geometry" /></mxCell><mxCell id="dA" value="Đạt điều kiện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="720" width="150" height="76" as="geometry" /></mxCell><mxCell id="dB" value="Kết quả?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="720" width="150" height="76" as="geometry" /></mxCell><mxCell id="qB3" value="'Bị từ chối': ghi lý do; không thực hiện; ca gốc tiếp tục" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="728" width="196" height="59" as="geometry" /></mxCell><mxCell id="eB3" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="805" width="30" height="30" as="geometry" /></mxCell><mxCell id="mC" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="910" width="50" height="40" as="geometry" /></mxCell><mxCell id="dFee" value="Có phát sinh chi phí?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="990" width="150" height="76" as="geometry" /></mxCell><mxCell id="q4" value="'Chờ BN xác nhận': gửi tên dịch vụ, đơn giá, tổng tiền mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1006" width="196" height="44" as="geometry" /></mxCell><mxCell id="q5" value="Xác nhận trên app của mình hoặc đọc OTP cho ĐD, hạn 10 phút; ĐD không bấm thay" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1090" width="196" height="74" as="geometry" /></mxCell><mxCell id="dBN" value="Đồng ý?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1192" width="150" height="76" as="geometry" /></mxCell><mxCell id="q5x" value="'BN hủy / từ chối': không tính tiền; ca gốc tiếp tục" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1200" width="196" height="59" as="geometry" /></mxCell><mxCell id="eq5" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="1215" width="30" height="30" as="geometry" /></mxCell><mxCell id="q6" value="Chốt giá; dòng 'Đã đồng ý' (và 'Được duyệt' nếu nhánh B); lưu thời điểm, bằng chứng đồng ý" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1310" width="196" height="74" as="geometry" /></mxCell><mxCell id="mD" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="1420" width="50" height="40" as="geometry" /></mxCell><mxCell id="q7" value="Thực hiện dịch vụ phát sinh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1505" width="196" height="44" as="geometry" /></mxCell><mxCell id="dDo" value="Thực hiện được?" style="rhombus;whit
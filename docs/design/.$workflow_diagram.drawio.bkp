y x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.136;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="jb" target="k6"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1305" /><mxPoint x="400" y="1305" /></Array></mxGeometry></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cRt" target="k9"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k9" target="k10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1418.0" /><mxPoint x="160" y="1418.0" /></Array></mxGeometry></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k10" target="kd4"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed22" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="kd4" target="e"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed23" value="Không – khiếu nại lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="kd4" target="k11"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k11" target="k12"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k12" target="e2"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Vi phạm của ĐD bị khiếu nại chỉ ghi theo kết luận của luồng này; các đơn bị chuyển sang luồng 06 do tạm khóa không bị xét vi phạm thêm. Không vi phạm → gỡ khóa, không ghi gì.&lt;br&gt;• Điều dưỡng dùng cùng luồng để báo cáo bệnh nhân / người nhà có hành vi không an toàn; khi đó biện pháp tạm thời là chặn đặt lịch mới và cảnh báo ĐD được phân công.&lt;br&gt;• Bộ hẹn giờ 3 / 5 ngày chạy song song với việc xử lý, không phải bước kiểm tra sau khi xử lý xong.&lt;br&gt;• Cả người khiếu nại và bên bị khiếu nại đều có quyền khiếu nại lại 1 lần. Điểm nối Ⓡ: sang bước trả kết quả.&lt;br&gt;• Người phúc tra luôn khác người kết luận lần đầu (BR-11); khối phúc tra đặt ở làn Admin nhưng có thể do Quản trị trưởng BV thực hiện khi Admin đã xử lý thay. Quá 5 ngày: Admin xử lý thay, nhánh của QT BV dừng lại. Ghi nhận trễ hạn đưa vào báo cáo SLA tháng gửi BV &amp;amp; PO (đề xuất, Q-27).&lt;br&gt;• Thêm nhánh từ chối tiếp nhận khiếu nại quá 30 ngày không nghiêm trọng. Admin quá hạn khi xử lý thay (F3) hoặc xử lý khiếu nại về nền tảng (UC99) → ghi báo cáo SLA tháng gửi BV &amp;amp; PO.&lt;br&gt;• Khối xác minh / kết luận của QT BV nằm trong vùng ngắt: quá 5 ngày thì nhánh này bị hủy, chỉ còn kết luận của Admin đi tới bước trả kết quả." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1890.0" width="1440" height="122.0" as="geometry" /></mxCell><mxCell id="kad" value="Admin xử lý thay (BR-18 F3): dùng giải trình đã nộp hoặc mời giải trình lại; xác minh &amp;amp; kết luận trong 3 ngày làm việc; bồi hoàn nếu có → QT BV hoàn tiền thủ công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1323" width="196" height="74" as="geometry" /></mxCell><mxCell id="v7e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kad" target="k9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k2x" value="Nhận thông báo từ chối tiếp nhận (quá 30 ngày, không nghiêm trọng)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="523.0" width="196" height="59" as="geometry" /></mxCell><mxCell id="ek2x" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="610.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="v8e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2x" target="ek2x"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dLate12" value="Trong hạn 30 ngày hoặc nghiêm trọng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="400" width="170" height="90" as="geometry" /></mxCell><mxCell id="x83a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2" target="dLate12"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dLate12" target="kd1"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83c" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dLate12" target="k2x"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="445" /></Array></mxGeometry></mxCell><mxCell id="dTk" value="QT BV đã kết luận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565" y="1120" width="150" height="76" as="geometry" /></mxCell><mxCell id="eTk" value="" sty
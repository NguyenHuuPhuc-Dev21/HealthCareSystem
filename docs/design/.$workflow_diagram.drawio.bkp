dge="1" parent="1" source="qkad" target="qk2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="2080" y="885" /><mxPoint x="1840" y="885" /></Array></mxGeometry></mxCell><mxCell id="ed21" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qk2" target="qk4"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qk4" target="ek4"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed23" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qk2" target="qk3"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="qk3" target="ek3"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed25" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="qda" target="qref"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArr
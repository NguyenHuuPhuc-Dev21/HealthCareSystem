exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="md1"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="585" /><mxPoint x="400" y="585" /></Array></mxGeometry></mxCell><mxCell id="ed7" value="Thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="md1" target="m4"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed8" value="Thừa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="md1" target="mthua"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="mthua" target="m5"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="750" /></Array></mxGeometry></mxCell><mxCell id="ed10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="m4b"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed11" value="Nộp bù phần thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4b" target="m2"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="753" y="750" /><mxPoint x="753" y="450" /></Array></mxGeometry></mxCell><mxCell id="ed12" value="Khớp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="md1" target="m5"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Bắt đầu khi có tiền mặt ĐD đang giữ (luồng 08). Bộ hẹn giờ 48h chạy song song, dừng khi nộp đủ.&lt;br&gt;• Thủ quỹ nhập số tiền thực nhận; hệ thống tự so với số ĐD đang giữ.&lt;br&gt;• Nộp thiếu → công nợ còn lại tiếp tục tính hạn theo bộ hẹn giờ; nộp bù đủ → tự mở khóa.&lt;br&gt;• Đơn 'tranh chấp tiền mặt' (luồng 08): số ĐD phải nộp lấy theo số thực thu QT BV đã chốt. QT BV quá hạn chưa chốt → chưa có quy tắc cho số thực thu, công nợ BN / ĐD và bên chịu chênh lệch (BR-18 F5, Q-12 – CHẶN tính năng tiền mặt; pilot theo Q-23 không có tiền mặt)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="900" height="124.0" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f11" name="11. Đối chiếu giao dịch &amp; thu phí nền tảng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="2084" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 11. Đối chiếu giao dịch &amp;amp; thu phí nền tảng" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1790.0" as="geometry" /></mxCell><mxCell id="lh0" value="Cổng thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="1790.0" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="1790.0" as="geometry" /></mxCell><mxCell id="lh2" value="Quản trị bệnh viện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1790.0" as="geometry" /></mxCell><mxCell id="lh3" value="Admin nền tảng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="sA" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="g1" value="Gửi kết quả mỗi giao dịch / hoàn tiền (webhook)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="196" height="44" as="geometry" /></mxCell><mxCell id="g2" value="Kiểm chữ ký, chống xử lý trùng, cập nhật thanh toán (UC47); tiền về cho đơn đã hủy → tự tạo lệnh hoàn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="313" width="196" height="74" as="geometry" /></mxCell><mxCell id="eA" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="435" width="30" height="30" as="geometry" /></mxCell><mxCell id="sB" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="535" width="30" height="30" as="geometry" /></mxCell><mxCell id="g3" value="Cuối tháng: tổng hợp theo BV – thanh toán &amp;amp; hoàn tiền qua cổng; tiền mặt đã nộp (luồng 10); bù công ĐD; đối soát cọc theo BR-04: đã khấu trừ / đã hoàn / giữ lại / đang giữ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="592" width="196" height="112" as="geometry" /></mxCell><mxCell id="g4" value="Lấy sao kê đối soát từ cổng (API), đối chiếu với đơn hoàn thành (UC48)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="720.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="gd2" value="Khớp số liệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="912.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="g6" value="Mở đối soát chênh lệch với bệnh viện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="928.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="g7" value="Xác nhận / giải trình chênh lệch trong 7 ngày (quá hạn → BR-18 F7: coi như chấp nhận số liệu đối soát)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1020.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="gd3" value="Thống nhất?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="1112.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="g7x" value="Tách phần chưa thống nhất sang kỳ sau, xử lý riêng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1128.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="g8" value="Lập hóa đơn phí nền tảng trên tổng giá trị ca, gồm phát sinh (BR-05)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1213.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="g9" value="Lập bảng kê thu nhập ĐD theo chính sách BV (UC96)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1313.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="g10" value="Nhận hóa đơn; duyệt bảng kê; thanh toán phí, chi trả ĐD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="1428.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="gd4" value="Phí thanh toán đúng hạn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="1505.0" width="170" height="90" as="geometry" /></mxCell><mxCell id="g12" value="Nhắc thanh toán; quá hạn hợp đồng → báo Admin xem xét tạm ngưng nhận đơn mới của BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="1520.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="e12" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="1635.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="g11" value="Theo dõi công nợ phí; thống kê doanh thu (UC49)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1628.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105" y="1735.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sA" target="g1"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitD
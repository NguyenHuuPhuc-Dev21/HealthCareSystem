="1" as="geometry" /></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5n" target="r6n"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1520.5" /><mxPoint x="880" y="1520.5" /></Array></mxGeometry></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r6n" target="r7n"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1628.0" /><mxPoint x="400" y="1628.0" /></Array></mxGeometry></mxCell><mxCell id="ed22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r7n" target="r8n"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1728.0" /><mxPoint x="1120" y="1728.0" /></Array></mxGeometry></mxCell><mxCell id="ed23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r8n" target="r9n"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r9n" target="r10n"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1928.0" /><mxPoint x="640" y="1928.0" /></Array></mxGeometry></mxCell><mxCell id="ed25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r10n" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Giới hạn AI: chỉ sàng lọc, tóm tắt dữ liệu được phép, phát hiện thiếu dữ liệu, phân loại và chuyển yêu cầu, soạn nháp hành chính. AI không chẩn đoán cuối cùng, không kê đơn / đổi thuốc / quyết thủ thuật, không duyệt hồ sơ chuyên môn, không đổi kế hoạch chăm sóc, không quyết thanh toán / hoàn tiền / khiếu nại, không truy cập ngoài phạm vi được cấp. Kết quả hiển thị mục đích, giới hạn, mức không chắc chắn và đường chuyển cho người.&lt;br&gt;• Kết quả AI là công cụ hỗ trợ: không gửi đề xuất tái khám cho BN khi chưa có bác sĩ xác nhận, trừ cảnh báo khẩn cấp (hướng dẫn gọi 115).&lt;br&gt;• Bệnh nhân có thể thu hồi quyền xem của bác sĩ bất cứ lúc nào (UC102); quyền tự hết hạn khi kế hoạch kết thúc.&lt;br&gt;• Bộ hẹn giờ 2h / 4h chạy song song với việc đánh giá của bác sĩ.&lt;br&gt;• AI lỗi / không trả kết quả sau 3 lần thử trong 30 phút, hoặc BV tắt AI → coi như rủi ro cao, bác sĩ xem tất cả (BR-10).&lt;br&gt;• Bác sĩ chỉ xem lịch sử tại BV mình (BR-09, UC59). Xem lịch sử ở BV khác: KHÔNG thuộc phạm vi (Q-20 – đã chốt không làm trong MVP). Muốn mở cần thiết kế riêng quyền truy cập, thời hạn, thu hồi và nhật ký truy cập.&lt;br&gt;• Quá 4h → bác sĩ mới quay lại bước đánh giá; khi BN chọn tái khám ở BV khác, không tự gán bác sĩ của BV gốc (BR-09).&lt;br&gt;• Không chặn lập trình khung luồng, &lt;b&gt;chặn go-live&lt;/b&gt;: tiêu chí kiểm chứng AI &amp; văn bản trách nhiệm (Q-26), SLA bác sĩ trực khi cảnh báo khẩn (Q-21)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2200.0" width="1440" height="146.0" as="geometry" /></mxCell><mxCell id="dai" value="BV bật AI &amp;amp; AI trả kết quả? (thử tối đa 3 lần / 30 phút)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="295" width="190" height="110" as="geometry" /></mxCell><mxCell id="fai" value="AI lỗi hoặc BV tắt AI → coi như rủi ro cao; bác sĩ xem toàn bộ báo cáo (BR-10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="320.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="eai1" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dai" target="rd1"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell><mxCell id="eai2" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dai" target="fai"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell><mxCell id="eai3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fai" target="r2n"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="350" /><mxPoint x="510" y="770" /></Array></mxGeometry></mxCell><mxCell id="dTm" value="Bác sĩ đã đánh giá?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="1010" width="150" height="76" as="geometry" /></mxCell><mxCell id="eTm" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="1110" width="30" height="30" as="geometry" /></mxCell><mxCell id="r3b" value="Bác sĩ khác (QT BV phân công) xem báo cáo &amp;amp; kết quả AI, đánh giá (UC68)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1018.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="x83a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmr" target="dTm"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dTm" target="eTm"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83c" value="⚡ Không (quá 4h) – ngắt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dTm" target="r3b"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3b" target="rd2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1105" /><mxPoint x="1120" y="1105" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f14" name="14. Yêu cầu xóa dữ liệu cá nhân"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1886" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 14. Yêu cầu xóa dữ liệu cá nhân" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1590" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="1590" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="480" height="1590" as="geometry" /></mxCell><mxCell id="lh2" value="Admin nền tảng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="1590" as="geometry" /></mxCell><mxCell id="lh3" value="Quản trị các BV liên quan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="x1" value="Gửi yêu cầu xóa (UC61): chủ tài khoản cho hồ sơ của mình và hồ sơ người nhà do mình tạo; người thân tự đồng ý qua email thì tự gửi qua link trong email (không cần tài khoản)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="198" width="196" height="104" as="geometry" /></mxCell><mxCell id="x1b" value="Xác thực lại bằng OTP gửi qua email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="328" width="196" height="44" as="geometry" /></mxCell><mxCell id="xd0" value="OTP đúng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="412" width="150" height="76" as="geometry" /></mxCell><mxCell id="xbad" value="Nhận báo xác thực thất bại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="ebad" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="535" width="30" height="30" as="geometry" /></mxCell><mxCell id="xd1" value="Còn ràng buộc? (đơn đang chạy, khiếu nại mở, công nợ, hoàn tiền chờ, tái khám)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305" y="495" width="190" height="110" as="geometry" /></mxCell><mxCell id="x3" value="Hoãn; báo BN lý do; tự kích hoạt lại khi hết ràng buộc (BR-12)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="x2" value="Ghi nhận; bắt đầu đếm hạn 72 giờ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="728" width="196" height="44" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="846" width="660" height="8" as="geometry" /></mxCell><mxCell id="tmr" value="⏱ Còn 24h chưa xong → cảnh báo Admin (UC64); quá 72h → cảnh báo lần 2, ghi vi phạm hạn xử lý vào báo cáo SLA tháng gửi PO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="etm" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="1035" width="30" height="30" as="geometry" /></mxCell><mxCell id="x4" value="Xem xét yêu cầu (UC62)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="928" width="196" height="44" as="geometry" /></mxCell><mxCell id="xd2" value="Hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="1012" width="150" height="76" as="geometry" /></mxCell><mxCell id="x5" value="Từ chối &amp;amp; nêu lý do; báo BN (UC105)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="1028" width="196" height="44" as="geometry" /></mxCell><mxCell id="ex5" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105" y="1135" width="30" height="30" as="geometry" /></mxCell><mxCell id="x6" value="Mỗi BV liên quan xác định dữ liệu phải lưu theo luật, hạn 24h (UC104); quá hạn → áp danh mục lưu mặc định (hồ sơ bệnh án, chứng từ kế toán)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262" y="1105.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="x7" value="Xóa / ẩn danh / khóa truy cập theo nhóm dữ liệu (UC63); yêu cầu bên xử lý (AI, cổng thanh toán, dịch vụ email) xóa tương ứng; đóng tài khoản nếu xóa toàn bộ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1205.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="x9" value="Ghi log; báo BN phần đã xóa / được giữ lại &amp;amp; lý do (UC65)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="1328" width="196" height="44" as="geometry" /></mxCell><mxCell id="x10" value="Nhận kết quả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="1428" width="196" height="44" as="geometry" /></mxCell><mxCell id="e" value="" style="ellip
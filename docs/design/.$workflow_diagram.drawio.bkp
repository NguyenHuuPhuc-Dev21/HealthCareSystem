0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h12x" target="e12x"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed33" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="hd9" target="h13"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="h13" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Luồng này chỉ hoàn tiền cọc (trước / trong ca); hoàn tiền sau khi BN đã trả tiền dịch vụ (khiếu nại 12, khiếu nại dòng 08, giảm phí dừng ca 15) không có luồng tự động: QT BV hoàn thủ công – trả qua cổng hoàn về cổng, trả tiền mặt hoàn bằng chuyển khoản; hóa đơn đã xuất thì xuất hóa đơn điều chỉnh giảm; ghi lệnh hoàn, chứng từ và bên chịu (BV / ĐD) để đối soát ở luồng 11. Các mốc % hoàn theo BR-04 (đã đồng bộ hai file, chờ phê duyệt Q-02): đổi lịch được ưu đãi hơn hủy.&lt;br&gt;• Hủy khi đơn đang lỗi phía ĐD / BV (đang tìm người thay, ĐD trễ quá mốc, ghép nhanh chưa có ĐD) → luôn hoàn 100%, không xét giờ.&lt;br&gt;• Ngoại lệ hoàn cọc quá 48h chưa xử lý: BN bình thường → tự duyệt, BV chịu khoản bù công (ĐD vẫn nhận bù công như khi bị từ chối); BN có cờ lạm dụng (BR-19) → Admin quyết trong 3 ngày làm việc, quá hạn → giữ % theo BR-04.&lt;br&gt;• Đơn đặt ngay chỉ được hủy, không đổi lịch. BN vắng nhà → không hoàn cọc (luồng 07B).&lt;br&gt;• Tiền cọc về sau khi đơn đã hủy do hết hạn (luồng 04, 05) → đi thẳng vào bước tạo lệnh hoàn 100%.&lt;br&gt;• Hỏi loại yêu cầu trước, chỉ kiểm tra cọc trong nhánh hủy – đơn chưa cọc chọn đổi lịch không còn bị rơi vào nhánh hủy.&lt;br&gt;• Quá giờ phải xuất phát mà ĐD chưa bấm 'Xuất phát' là lỗi phía ĐD → hoàn 100% (cả đặt ngay sau mốc 5 phút), khớp BR-04.&lt;br&gt;• (1) Đơn chưa cọc không được đổi lịch (hai bộ hẹn giờ cọc 15 phút và ĐD xác nhận 30 phút va nhau) → hủy và đặt lại (Q-39). (2) Đặt ngay: hoàn 100% khi ĐD chưa bấm 'Xuất phát', 0% khi đã bấm — bỏ khoảng phút 5–10 (0%) nằm giữa hai mốc 100%, vốn khiến BN có lợi khi cố hủy muộn (Q-38). (3) Khi chọn lại ĐD, lịch và ĐD cũ được giữ tới khi ĐD mới xác nhận." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2080" width="1920" height="160.0" as="geometry" /></mxCell><mxCell id="fv" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="506" y="630" width="8" height="90" as="geometry" /></mxCell><mxCell id="r06x" value="▶ Luồng 06: QT BV xét vi phạm (không tìm người thay); đơn đang thay người thì đã ở 06" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="542" y="690" width="196" height="59" as="geometry" /></mxCell><mxCell id="x83a" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hdf" target="fv"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="x83b" value="hoàn 100%" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fv" target="h10"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="1550" /></Array></mxGeometry></mxCell><mxCell id="x83c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.994;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fv" target="r06x"><mxGeometry x="0" relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f10" name="10. Điều dưỡng nộp tiền mặt về bệnh viện"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="1164" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 10. Điều dưỡng nộp tiền mặt về bệnh viện" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="890" as="geometry" /></mxCell><mxCell id="lh0" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="890" as="geometry" /></mxCell><mxCell id="lh1" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="240" height="890" as="geometry" /></mxCell><mxCell id="lh2" value="Quản trị BV / Thủ quỹ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="246" width="420" height="8" as="geometry" /></mxCell><mxCell id="m1" value="Xem tiền mặt đang giữ &amp;amp; hạn nộp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="328" width="196" height="44" as="geometry" /></mxCell><mxCell id="tmr" value="⏱ Quá 48h chưa nộp đủ → cảnh báo, tạm khóa nhận đơn tiền mặt; quá 7 ngày → QT BV xử lý theo quy chế" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="313" width="196" height="74" as="geometry" /></mxCell><mxCell id="etm" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="335" width="30" height="30" as="geometry" /></mxCell><mxCell id="m2" value="Nộp tiền cho thủ quỹ, bấm 'Đã nộp', nhập số tiền (UC124)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="428" width="196" height="44" as="geometry" /></mxCell><mxCell id="m3" value="Kiểm đếm, nhập số tiền thực nhận (UC125)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="528" width="196" height="44" as="geometry" /></mxCell><mxCell id="md1" value="So thực nhận với số ĐD đang giữ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="605" width="170" height="90" as="geometry" /></mxCell><mxCell id="mthua" value="Thừa: ĐD cùng thủ quỹ rà đơn tiền mặt chưa ghi nhận; không có → ĐD nhận lại phần thừa, hai bên ký biên bản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="620.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="m4" value="Lập biên bản chênh lệch thiếu; xử lý theo quy chế BV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="628" width="196" height="44" as="geometry" /></mxCell><mxCell id="m4b" value="Ghi giảm công nợ theo số thực nhận; phần thiếu vẫn là công nợ ĐD, giữ khóa; báo ĐD nộp bù" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="720.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="m5" value="Xóa công nợ; mở khóa đơn tiền mặt nếu đang khóa; đưa vào đối chiếu tháng (luồng 11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="720.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="835" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.786;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" 
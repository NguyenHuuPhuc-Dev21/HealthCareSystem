row=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="xd2" target="x5"><mxGeometry x="-0.6" relative="1" as="geometry" /></mxCell><mxCell id="ed16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x5" target="ex5"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed17" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="xd2" target="x6"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1096.75" /><mxPoint x="1360" y="1096.75" /></Array></mxGeometry></mxCell><mxCell id="ed18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x6" target="x7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1200" /><mxPoint x="400" y="1200" /></Array></mxGeometry></mxCell><mxCell id="ed19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x7" target="x9"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="ed20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x9" target="x10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1408" /><mxPoint x="160" y="1408" /></Array></mxGeometry></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x10" target="e"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Hạn 72 giờ tính từ lúc hết ràng buộc (BR-12); bộ hẹn giờ chạy song song với việc xử lý. Điểm nối Ⓗ: hết ràng buộc → kiểm tra lại.&lt;br&gt;• Xóa toàn bộ tài khoản: các hồ sơ người thân do tài khoản này tạo cũng bị xóa; hồ sơ người thân đã tự đồng ý qua email được báo cho chính người đó trước khi xóa.&lt;br&gt;• Hồ sơ bệnh án và chứng từ kế toán tại bệnh viện được giữ theo thời hạn luật định; trên nền tảng chỉ còn bản đã ẩn danh hoặc khóa truy cập.&lt;br&gt;• Ai được yêu cầu xóa dữ liệu của ai (BR-12): chủ tài khoản → dữ liệu của mình và hồ sơ người nhà do mình tạo (theo cam kết đại diện khi tạo hồ sơ); người thân đã tự đồng ý qua email → chính người đó yêu cầu qua link email; chủ tài khoản chỉ gỡ liên kết hồ sơ đó khỏi tài khoản mình.&lt;br&gt;• Thời hạn lưu trữ và danh mục lưu mặc định (Q-14): code dạng tham số, &lt;b&gt;pháp chế duyệt trước go-live&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="1440" height="146.0" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="f15" name="15. Dừng ca giữa chừng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1532" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 15. Dừng ca giữa chừng" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1240" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="1240" as="geometry" /></mxCell><mxCell id="lh1" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="480" height="1240" as="geometry" /></mxCell><mxCell id="lh2" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1240" as="geometry" /></mxCell><mxCell id="lh3" value="Bác sĩ trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="1240" as="geometry" /></mxCell><mxCell id="lh4" value="Quản trị BV (Điều phối)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385.0" y="135.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="f1" value="Đã làm ít nhất một hạng mục của dịch vụ gốc nhưng phải dừng; chọn lý do (UC127)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302.0" y="320.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="d1" value="Lý do dừng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="565.0" y="412.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="f4" value="Xác nhận yêu cầu dừng trên app / đọc OTP; 10 phút không xác nhận → ĐD ghi chú lý do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62.0" y="520.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="f2" value="Bấm SOS (UC92); hướng dẫn gọi 115; sơ cứu, ở lại đến khi bàn giao 115 / người nhà" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302.0" y="520.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="f4b" value="Ghi lý do phía ĐD; phần dở dang không tính phí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782.0" y="528.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="f2b" value="Nhận SOS, hướng dẫn từ xa; ghi nhận sự cố (UC134)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022.0" y="528.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="f3" value="Không an toàn: rời nhà BN ngay, bấm SOS; ▶ luồng 12 báo cáo hành vi. QT BV hậu kiểm lý do ở UC128 – khai sai → ghi vi phạm ĐD (Q-46)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302.0" y="613" width="196" height="74" as="geometry" /></mxCell><mxCell id="r06" value="▶ Luồng 06 (song song, không chặn thanh toán): QT BV xét lý do &amp;amp; vi phạm một lần (UC88); BN muốn → ghép nhanh ĐD khác làm phần còn lại bằng đơn con (không cọc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="782.0" y="613.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="f5" value="Chốt dòng đơn: xong → &amp;#x27;Đã thực hiện&amp;#x27;; dở dang → &amp;#x27;Dừng giữa chừng&amp;#x27;; tính phí tạm theo lý do ĐD chọn (BR-16)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542.0" y="713.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="bar" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="846.0" width="1140" height="8" as="geometry" /></mxCell><mxCell id="f6" value="Nộp báo cáo chăm sóc bắt buộc: thời điểm, lý do dừng, tình trạng BN lúc rời, bàn giao cho 115 / người nhà / ĐD làm tiếp (UC43)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302.0" y="920.5" width="196" height="59" as="geometry" /></mxCell><mxCell id="r08" value="▶ Luồng 08 ngay: thanh toán theo phí tạm tính (nhánh 'Dừng giữa chừng'). Thu tiền mặt tại chỗ chỉ khi BN xác nhận rõ bảng kê; không an toàn / cấp cứu → không thu tại chỗ: BN xác nhận trong 24h, trả qua cổng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="542.0" y="905.5" width="196" height="89" as="geometry" /></mxCell><mxCell id="f7" value="Xác nhận mức phí trong 24h (UC128): chỉ giữ hoặc giảm; lý do do ĐD → dùng kết quả UC88 ở luồng 06; quá hạn → BR-18 F9" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262.0" y="913.0" width="196" height="74" as="geometry" /></mxCell><mxCell id="e6" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385.0" y="1035.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="e" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625.0" y="1035.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="e7" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105.0" y="1035.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="d2" value="Giảm phí?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="1012.0" width="150" height="76" as="geometry" /></mxCell><mxCell id="r9b" value="Hoàn phần chênh cho BN: QT BV hoàn tiền thủ công (qua cổng hoặc chuyển khoản), xuất hóa đơn điều chỉnh; ghi lệnh hoàn + chứng từ để đối soát (UC90, UC126)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1262.0" y="1128.0" width="196" height="44" as="geometry" /></mxCell><mxCell id="e9" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345.0" y="1235.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="ed0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="394.0" /><mxPoint x="640" y="394.0" /></Array></mxGeometry></mxCell><mxCell id="ed2" value="BN yêu cầu / không hợp tác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="f4"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="160" y="450" /></Array></mxGeometry></mxCell><mxCell id="ed3" value="Cấp cứu y khoa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="f2"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="640" y="505" /><mxPoint x="400" y="505" /></Array></mxGeometry></mxCell><mxCell id="ed4" value="Do ĐD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="f4b"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="880" y="450" /></Array></mxGeometry></mxCell><mxCell id="ed5" value="Không an toàn cho ĐD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="f3"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="640" y="650" /></Array></mxGeometry></mxCell><mxCell id="ed6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f2b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="550" /><mxPoint x="510" y="592" /><mxPoint x="1000" y="592" /><mxPoint x="1000" y="550" /></Array></mxGeometry></mxCell><mxCell id="ed7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4b" target="bar6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="750" /></Array></mxGeometry></mxCell><mxCell id="ed9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2b" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="768" /></Array></mxGeometry></mxCell><mxCell id="ed10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="650" /><mxPoint x="290" y="700" /><mxPoint x="520" y="700" /><mxPoint x="520" y="731" /></Array></mxGeometry></mxCell><mxCell id="ed11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar6" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="593" /><mxPoint x="760" y="731" /></Array></mxGeometry></mxCell><mxCell id="ed12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.289;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f5" target="bar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.079;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.289;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="r08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.921;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f6" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r08" target="e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f7" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed19" value="Giữ / ⏱ quá hạn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="e7"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell><mxCell id="ed20" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="r9b"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell><mxCell id="ed21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r9b" target="e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• (1) lý do do ĐD chỉ xét vi phạm MỘT lần ở luồng 06 (UC88), không xác nhận lại ở UC128; (2) thanh toán chạy ngay theo phí tạm tính để còn thu tiền mặt tại chỗ (khi BN xác nhận rõ – Q-33); QT BV chỉ được giữ hoặc giảm, giảm → QT BV hoàn tiền thủ công.&lt;br&gt;• Chỉ áp dụng khi ĐD đã bấm 'Bắt đầu chăm sóc'. Chưa bắt đầu mà không làm được → lý do 'dịch vụ gốc không làm được' ở 07B / 08.&lt;br&gt;• Tính phí (đề xuất, Q-08): hạng mục đã xong tính đủ; dở dang do BN yêu cầu / không hợp tác → 50%; tình trạng BN không phù hợp → 0; cấp cứu y khoa → 0, không thu phí đến nhà (khớp BR-04); do ĐD / BV → 0.&lt;br&gt;• Mọi nhánh kết thúc bằng ⊗: chuyển sang luồng 08 không được cắt nhánh QT BV xác nhận phí 24h và nhánh nộp báo cáo.&lt;br&gt;• Sự cố tại nhà ghi nhận riêng (UC134); trách nhiệm / bảo hiểm chờ Q-24.&lt;br&gt;• Ranh giới với 07B / 08 = đã làm ít nhất một hạng mục của dịch vụ gốc (không phải chỉ bấm 'Bắt đầu'): chưa làm hạng mục nào → 'dịch vụ gốc không làm được' (phí đến nhà theo BR-04), nên bấm Bắt đầu rồi dừng ngay không còn rẻ hơn (Q-40). Luồng 06 chạy song song; phần còn lại do ĐD khác làm là đơn con không cọc, BN trả sau ca (Q-36). Lý do không an toàn / cấp cứu không thu tiền mặt tại chỗ.&lt;br&gt;• Tách nhánh 'tình trạng không phù hợp' (phần dở dang 0) khỏi nhánh 'BN yêu cầu / không hợp tác' (phần dở dang 50%); lý do 'không an toàn cho ĐD': phần dở dang 0, không phí đến nhà, QT BV xác nhận ở UC128 (BR-16).&lt;br&gt;• Không chặn lập trình khung luồng, &lt;b&gt;chặn go-live&lt;/b&gt;: trách nhiệm &amp; bảo hiểm sự cố tại nhà (Q-24), SLA bác sĩ trực nhận SOS (Q-21)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1440" height="142.0" as="geometry" /></mxCell><mxCell id="bar6" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="589" width="180" height="8" as="geometry" /></mxCell><mxCell id="v8e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar6" target="r06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e06" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1015" y="635" width="30" height="30" as="geometry" /></mxCell><mxCell id="v8e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r06" target="e06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4c" value="Được ĐD báo tình trạng không phù hợp (không cấp cứu), khuyên khám tại BV; xác nhận trên app (10 phút không xác nhận → ĐD ghi chú)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="800" width="196" height="74" as="geometry" /></mxCell><mxCell id="v8t1" value="Tình trạng không phù hợp (không cấp cứu)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="f4c"><mxGeometry relative="1" as="geometry" x="-0.6"><Array as="points"><mxPoint x="602.5" y="490" /><mxPoint x="270" y="490" /><mxPoint x="270" y="837" /></Array></mxGeometry></mxCell><mxCell id="v8t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4c" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="768.5" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f17" name="17. SOS &amp; ứng phó khẩn cấp"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Luồng 17. SOS &amp; ứng phó khẩn cấp" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry" /></mxCell><mxCell id="ln0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="1300" as="geometry" /></mxCell><mxCell id="lh0" value="Bệnh nhân / Người nhà" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="1300" as="geometry" /></mxCell><mxCell id="lh1" value="Điều dưỡng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="ln2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="480" height="1300" as="geometry" /></mxCell><mxCell id="lh2" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="480" height="40" as="geometry" /></mxCell><mxCell id="ln3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=25;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="1300" as="geometry" /></mxCell><mxCell id="lh3" value="Đầu mối trực (bác sĩ trực / QT BV)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="240" height="40" as="geometry" /></mxCell><mxCell id="s1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="s2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="385" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="s3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="135" width="30" height="30" as="geometry" /></mxCell><mxCell id="i1" value="Bấm SOS bất kỳ lúc nào – không cần chờ AI hay bác sĩ (UC140)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1f5fe;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="200" width="196" height="74" as="geometry" /></mxCell><mxCell id="i2" value="Bấm SOS trong ca (UC92)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="302" y="215" width="196" height="44" as="geometry" /></mxCell><mxCell id="i3" value="Điểm vào: khẩn cấp từ sàng lọc (04, 05, 07A), AI / bác sĩ (13), dịch vụ phát sinh (07C); SOS của ĐD trong ca (07B, 15) đi vào làn Điều dưỡng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="200" width="196" height="74" as="geometry" /></mxCell><mxCell id="m0" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="320" width="50" height="40" as="geometry" /></mxCell><mxCell id="h1" value="Hiển thị ngay hướng dẫn gọi 115 và nút gọi bằng điện thoại của người dùng; ghi thời điểm, người kích hoạt, vị trí (nếu được phép)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="393" width="196" height="104" as="geometry" /></mxCell><mxCell id="fb" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="526" width="820" height="8" as="geometry" /></mxCell><mxCell id="b1" value="Gọi 115 bằng điện thoại của mình – hệ thống KHÔNG tự gọi 115 khi chưa có tích hợp hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="573" width="196" height="74" as="geometry" /></mxCell><mxCell id="eb1" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="145" y="680" width="30" height="30" as="geometry" /></mxCell><mxCell id="h2" value="Thông báo đầu mối trực theo cấu hình (bác sĩ trực, QT BV, ĐD đang phân công) với thông tin tối thiểu cần thiết" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="542" y="565" width="196" height="89" as="geometry" /></mxCell><mxCell id="dAck" value="Đầu mối xác nhận trong 5 phút?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="690" width="170" height="90" as="geometry" /></mxCell><mxCell id="h2b" value="Leo thang: báo đầu mối dự phòng; ghi trễ phản hồi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="705" width="196" height="59" as="geometry" /></mxCell><mxCell id="h3" value="Liên hệ lại BN / ĐD, hướng dẫn từ xa; ghi thời điểm và hành động (UC134)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1022" y="813" width="196" height="74" as="geometry" /></mxCell><mxCell id="dCa" value="Đơn đang trong ca chăm sóc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="915" width="170" height="90" as="geometry" /></mxCell><mxCell id="h3b" value="Mở luồng 15 cho đơn (lý do cấp cứu y khoa) – không thu tiền tại chỗ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="782" y="930" width="196" height="59" as="geometry" /></mxCell><mxCell id="m1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1095" y="1040" width="50" height="40" as="geometry" /></mxCell><mxCell id="h4" value="Đóng sự cố: kết quả, mốc thời gian, người xử lý; báo QT BV; lưu nhật ký" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;str
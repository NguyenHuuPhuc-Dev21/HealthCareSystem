<mxfile host="Electron" pages="19">
  <diagram id="toc" name="00. Mục lục">
    <mxGraphModel dx="1408" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b style=&quot;font-size:18px&quot;&gt;Luồng hoạt động – Nền tảng đặt điều dưỡng chăm sóc tại nhà (bản 8.14 – bản chốt)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:13px;&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#dae8fc;font-weight:bold&quot;&gt;&lt;td&gt;Mã&lt;/td&gt;&lt;td&gt;Luồng&lt;/td&gt;&lt;td&gt;Làn (tác nhân)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cấp tài khoản và xác minh hồ sơ điều dưỡng / bác sĩ (BV xác nhận → nền tảng duyệt)&lt;/td&gt;&lt;td&gt;Quản trị bệnh viện, Hệ thống, Admin nền tảng, Điều dưỡng / Bác sĩ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đăng ký bệnh nhân &amp;amp; tạo hồ sơ&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đăng nhập &amp;amp; phân quyền&lt;/td&gt;&lt;td&gt;Người dùng, Hệ thống&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đặt lịch hẹn trước – bệnh nhân chọn điều dưỡng&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Hệ thống AI, Bác sĩ trực, Điều dưỡng, Cổng thanh toán&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đặt ngay – ghép nhanh (tự gán)&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Điều dưỡng, Cổng thanh toán&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Điều dưỡng báo nghỉ / đổi người – tìm người thay&lt;/td&gt;&lt;td&gt;Điều dưỡng, Hệ thống, Quản trị bệnh viện, Bệnh nhân / Người nhà, Điều dưỡng thay&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;07A&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Chuẩn bị ca hẹn trước (chỉ đơn đặt trước)&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Hệ thống AI, Bác sĩ trực, Điều dưỡng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;07B&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Thực hiện ca chăm sóc (dùng chung đặt trước &amp;amp; đặt ngay)&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Điều dưỡng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;07C&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dịch vụ phát sinh trong ca – nhánh A / B / C&lt;/td&gt;&lt;td&gt;Điều dưỡng, Hệ thống, Bác sĩ trực / người có thẩm quyền, Bệnh nhân / Người nhà&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Xác nhận, thanh toán sau ca &amp;amp; xuất hóa đơn&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Điều dưỡng, Cổng thanh toán, Quản trị BV / Hệ thống hóa đơn BV, Admin nền tảng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;09&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bệnh nhân hủy / đổi lịch &amp;amp; hoàn cọc&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Quản trị bệnh viện, Admin nền tảng, Cổng thanh toán&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Điều dưỡng nộp tiền mặt về bệnh viện&lt;/td&gt;&lt;td&gt;Điều dưỡng, Hệ thống, Quản trị BV / Thủ quỹ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đối chiếu giao dịch &amp;amp; thu phí nền tảng&lt;/td&gt;&lt;td&gt;Cổng thanh toán, Hệ thống, Quản trị bệnh viện, Admin nền tảng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Khiếu nại &amp;amp; báo cáo hành vi&lt;/td&gt;&lt;td&gt;Người khiếu nại (BN / ĐD), Hệ thống, Quản trị bệnh viện, Admin nền tảng, Bên bị khiếu nại&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;13&lt;/b&gt;&lt;/td&gt;&lt;td&gt;AI phân tích rủi ro &amp;amp; tái khám&lt;/td&gt;&lt;td&gt;Hệ thống AI, Hệ thống, Bệnh nhân / Người nhà, Quản trị bệnh viện, Bác sĩ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Yêu cầu xóa dữ liệu cá nhân&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Hệ thống, Admin nền tảng, Quản trị các BV liên quan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;15&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dừng ca giữa chừng&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Điều dưỡng, Hệ thống, Bác sĩ trực, Quản trị BV (Điều phối)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td&gt;SOS và ứng phó khẩn cấp&lt;/td&gt;&lt;td&gt;Bệnh nhân / Người nhà, Điều dưỡng, Hệ thống, Đầu mối trực (bác sĩ trực / QT BV)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1220" width="1200" x="180" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

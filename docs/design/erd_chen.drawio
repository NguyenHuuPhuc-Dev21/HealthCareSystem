<mxfile host="app.diagrams.net" pages="14"><diagram id="e0" name="00. Tổng quan"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2103" pageHeight="2194" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e0c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;ERD Chen – tổng quan các thực thể chính&lt;/b&gt;&lt;br&gt;26 thực thể cốt lõi, 63 mối quan hệ. Để dễ đọc, trang này bỏ các quan hệ &quot;người thao tác / người duyệt&quot; với Tài khoản và các khóa hospital_id lặp lại; đầy đủ 192 quan hệ của 75 thực thể ở các trang 01–13.&lt;br&gt;Ký hiệu Chen: hình chữ nhật = thực thể (tên tiếng Việt + tên bảng), hình thoi = mối quan hệ, số trên đường nối = bản số (1 / N). Không vẽ thuộc tính. Mỗi khóa ngoại trong schema.sql là một mối quan hệ; di chuột lên hình thoi để xem cột khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="100" as="geometry"/></mxCell>
<UserObject id="e0c2" label="Bệnh viện&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;hospital&lt;/span&gt;" tooltip="Bệnh viện (tenant) ký hợp đồng với nền tảng, đứng tên nhận tiền (UC80, BR-05)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1158" y="1228" width="160" height="56" as="geometry"/></mxCell></UserObject>
<UserObject id="e0c3" label="Cơ sở&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;facility&lt;/span&gt;" tooltip="Cơ sở của bệnh viện; BN chọn cơ sở khi đặt lịch, vùng phục vụ tính theo cơ sở (BR-06)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="687" y="1361" width="160" height="56" as="geometry"/></mxCell></UserObject>

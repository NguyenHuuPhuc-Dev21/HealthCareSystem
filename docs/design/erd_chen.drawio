<diagram id="e9" name="09. Đối soát &amp; phí nền tảng"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1519" pageHeight="1528" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e9c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;9. Đối soát &amp;amp; phí nền tảng&lt;/b&gt;&lt;br&gt;5 thực thể của nhóm (xanh), 12 mối quan hệ. Thực thể xám nét đứt thuộc nhóm khác, được vẽ lại để thể hiện quan hệ.&lt;br&gt;Ký hiệu Chen: hình chữ nhật = thực thể (tên tiếng Việt + tên bảng), hình thoi = mối quan hệ, số trên đường nối = bản số (1 / N). Không vẽ thuộc tính. Mỗi khóa ngoại trong schema.sql là một mối quan hệ; di chuột lên hình thoi để xem cột khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="100" as="geometry"/></mxCell>
<UserObject id="e9c2" label="Kỳ đối soát&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;reconciliation_period&lt;/span&gt;" tooltip="Kỳ đối chiếu tháng theo BV (UC48, luồng 11 phần B)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="794" y="1024" width="160" height="56" as="geometry"/></mxCell></UserObject>
<UserObject id="e9c3" label="Chênh lệch đối soát&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;reconciliation_discrepancy&lt;/span&gt;" tooltip=""><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="532" y="1366" width="160" height="56" as="geometry"/></mxCell></UserObject>

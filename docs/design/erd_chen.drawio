<diagram id="e7" name="07. Thực hiện ca chăm sóc"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2234" pageHeight="1999" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e7c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;7. Thực hiện ca chăm sóc&lt;/b&gt;&lt;br&gt;10 thực thể của nhóm (xanh), 27 mối quan hệ. Thực thể xám nét đứt thuộc nhóm khác, được vẽ lại để thể hiện quan hệ.&lt;br&gt;Ký hiệu Chen: hình chữ nhật = thực thể (tên tiếng Việt + tên bảng), hình thoi = mối quan hệ, số trên đường nối = bản số (1 / N). Không vẽ thuộc tính. Mỗi khóa ngoại trong schema.sql là một mối quan hệ; di chuột lên hình thoi để xem cột khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="100" as="geometry"/></mxCell>
<UserObject id="e7c2" label="Diễn biến ca&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;care_visit&lt;/span&gt;" tooltip="Diễn biến ca tại nhà: xuất phát, check-in, bắt đầu, kết thúc (luồng 07B)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="931" y="378" width="160" height="56" as="geometry"/></mxCell></UserObject>
<UserObject id="e7c3" label="Điểm định vị&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;visit_location_point&lt;/span&gt;" tooltip="Vị trí ĐD từ lúc xuất phát đến check-in; phát hiện tắt định vị &gt; 10 phút (UC38, UC77)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1279" y="514" width="160" height="56" as="geometry"/></mxCell></UserObject>

<diagram id="e11" name="11. AI rủi ro &amp; tái khám"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1469" pageHeight="2241" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e11c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;11. AI rủi ro &amp;amp; tái khám&lt;/b&gt;&lt;br&gt;4 thực thể của nhóm (xanh), 15 mối quan hệ. Thực thể xám nét đứt thuộc nhóm khác, được vẽ lại để thể hiện quan hệ.&lt;br&gt;Ký hiệu Chen: hình chữ nhật = thực thể (tên tiếng Việt + tên bảng), hình thoi = mối quan hệ, số trên đường nối = bản số (1 / N). Không vẽ thuộc tính. Mỗi khóa ngoại trong schema.sql là một mối quan hệ; di chuột lên hình thoi để xem cột khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="100" as="geometry"/></mxCell>
<UserObject id="e11c2" label="Đánh giá rủi ro&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;risk_assessment&lt;/span&gt;" tooltip="AI phân tích rủi ro từ báo cáo chăm sóc (UC54)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="646" y="1638" width="160" height="56" as="geometry"/></mxCell></UserObject>
<UserObject id="e11c3" label="Cảnh báo rủi ro&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;risk_alert&lt;/span&gt;" tooltip="Cảnh báo rủi ro cao gửi bác sĩ phụ trách / trực (UC55, UC68, UC103)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="1228" width="160" height="56" as="geometry"/></mxCell></UserObject>

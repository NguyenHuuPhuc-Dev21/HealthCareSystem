<diagram id="e1" name="01. Bệnh viện &amp; cấu hình"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1013" pageHeight="999" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e1c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;1. Bệnh viện &amp;amp; cấu hình&lt;/b&gt;&lt;br&gt;5 thực thể của nhóm (xanh), 3 mối quan hệ. Thực thể xám nét đứt thuộc nhóm khác, được vẽ lại để thể hiện quan hệ.&lt;br&gt;Ký hiệu Chen: hình chữ nhật = thực thể (tên tiếng Việt + tên bảng), hình thoi = mối quan hệ, số trên đường nối = bản số (1 / N). Không vẽ thuộc tính. Mỗi khóa ngoại trong schema.sql là một mối quan hệ; di chuột lên hình thoi để xem cột khóa ngoại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="100" as="geometry"/></mxCell>
<UserObject id="e1c2" label="Bệnh viện&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;hospital&lt;/span&gt;" tooltip="Bệnh viện (tenant) ký hợp đồng với nền tảng, đứng tên nhận tiền (UC80, BR-05)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="589" width="160" height="56" as="geometry"/></mxCell></UserObject>
<UserObject id="e1c3" label="Cơ sở&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;font-style:italic&quot;&gt;facility&lt;/span&gt;" tooltip="Cơ sở của bệnh viện; BN chọn cơ sở khi đặt lịch, vùng phục vụ tính theo cơ sở (BR-06)"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="634" y="242" width="160" height="56" as="geometry"/></mxCell></UserObject>

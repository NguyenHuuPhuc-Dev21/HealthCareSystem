<mxCell id="c219" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeColor=#666666;rounded=1;" edge="1" parent="1" source="c152" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c220" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeColor=#666666;rounded=1;" edge="1" parent="1" source="c153" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c221" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#666666;rounded=1;" edge="1" parent="1" source="c155" target="c143"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c222" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#666666;rounded=1;" edge="1" parent="1" source="c160" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="00b. Danh mục bảng"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c223" value="&lt;b style=font-size:20px&gt;Danh mục bảng theo nhóm&lt;/b&gt;&lt;br&gt;75 bảng, 192 khóa ngoại. Di chuột lên tên bảng ở các trang chi tiết để xem mô tả." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/></mxCell>
<mxCell id="c224" value="&lt;b&gt;1. Bệnh viện &amp;amp; cấu hình&lt;/b&gt;&lt;br&gt;• hospital &lt;span style=&quot;color:#666&quot;&gt;– Bệnh viện&lt;/span&gt;&lt;br&gt;• facility &lt;span style=&quot;color:#666&quot;&gt;– Cơ sở của bệnh viện; BN chọn cơ sở khi đặt lịch, vùng phục vụ tính theo cơ sở&lt;/span&gt;&lt;br&gt;• hospital_payment_account &lt;span style=&quot;color:#666&quot;&gt;– Tài khoản nhận tiền của BV liên kết cổng thanh toán&lt;/span&gt;&lt;br&gt;• system_parameter &lt;span style=&quot;color:#666&quot;&gt;– Tham số chung do Admin nền tảng cấu hình theo ngày hiệu lực&lt;/span&gt;&lt;br&gt;• hospital_setting &lt;span style=&quot;color:#666&quot;&gt;– Cấu hình riêng BV có ngày hiệu lực: tỷ lệ chia, mức phạt / hoàn, khung giờ trong khung chung…&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="720" height="124" as="geometry"/></mxCell>
<mxCell id="c225" value="&lt;b&gt;2. Tài khoản &amp;amp; phân quyền&lt;/b&gt;&lt;br&gt;• user_account &lt;span style=&quot;color:#666&quot;&gt;– Tài khoản đăng nhập bằng email cho mọi tác nhân&lt;/span&gt;&lt;br&gt;• email_code &lt;span style=&quot;color:#666&quot;&gt;– Mã / link gửi qua email: đăng ký, 2 lớp, quên mật khẩu, kích hoạt, xác thực lại&lt;/span&gt;&lt;br&gt;• hospital_admin_role &lt;span style=&quot;color:#666&quot;&gt;– Vai trò con của Quản trị BV: trưởng / điều phối / kế toán / nhân sự – chất lượng&lt;/span&gt;&lt;br&gt;• terms_version &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• terms_acceptance &lt;span style=&quot;color:#666&quot;&gt;– Đồng ý điều khoản theo phiên bản&lt;/span&gt;&lt;br&gt;• audit_log &lt;span style=&quot;color:#666&quot;&gt;– Nhật ký kiểm toán &amp;amp; truy cập hồ sơ, chỉ ghi thêm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="720" height="142" as="geometry"/></mxCell>
<mxCell id="c226" value="&lt;b&gt;3. Nhân sự (điều dưỡng, bác sĩ)&lt;/b&gt;&lt;br&gt;• staff_profile &lt;span style=&quot;color:#666&quot;&gt;– Hồ sơ nhân sự ĐD / BS gắn BV; trạng thái xác minh 2 bước&lt;/span&gt;&lt;br&gt;• staff_document &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• staff_review_event &lt;span style=&quot;color:#666&quot;&gt;– Lịch sử duyệt / bổ sung / từ chối / khóa hồ sơ nhân sự&lt;/span&gt;&lt;br&gt;• nurse_skill &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_service_area &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_availability &lt;span style=&quot;color:#666&quot;&gt;– Lịch trống điều dưỡng khai báo cho 14 ngày tới&lt;/span&gt;&lt;br&gt;• doctor_on_call_shift &lt;span style=&quot;color:#666&quot;&gt;– Lịch trực bác sĩ: phân loại khi AI lỗi, duyệt y lệnh, đầu mối SOS&lt;/span&gt;&lt;br&gt;• staff_lock &lt;span style=&quot;color:#666&quot;&gt;– Tạm khóa kỹ thuật nhận ca&lt;/span&gt;&lt;br&gt;• staff_score_event &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="720" height="196" as="geometry"/></mxCell>
<mxCell id="c227" value="&lt;b&gt;4. Bệnh nhân &amp;amp; đồng ý dữ liệu&lt;/b&gt;&lt;br&gt;• patient_profile &lt;span style=&quot;color:#666&quot;&gt;– Hồ sơ người được chăm sóc; một tài khoản quản lý nhiều hồ sơ người thân&lt;/span&gt;&lt;br&gt;• patient_address &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• patient_consent &lt;span style=&quot;color:#666&quot;&gt;– Consent xử lý dữ liệu sức khỏe theo từng hồ sơ&lt;/span&gt;&lt;br&gt;• medical_order &lt;span style=&quot;color:#666&quot;&gt;– Chỉ định / y lệnh BN tải lên cho dịch vụ cần y lệnh, bác sĩ trực kiểm tra&lt;/span&gt;&lt;br&gt;• patient_abuse_flag &lt;span style=&quot;color:#666&quot;&gt;– Cờ lạm dụng theo tài khoản BN, chỉ đổi người quyết khi quá hạn&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="720" height="124" as="geometry"/></mxCell>
<mxCell id="c228" value="&lt;b&gt;5. Dịch vụ &amp;amp; bảng giá&lt;/b&gt;&lt;br&gt;• care_report_template &lt;span style=&quot;color:#666&quot;&gt;– Biểu mẫu báo cáo chăm sóc theo loại dịch vụ, có trường bắt buộc&lt;/span&gt;&lt;br&gt;• service &lt;span style=&quot;color:#666&quot;&gt;– Danh mục dịch vụ / vật tư của BV với cờ được phép tại nhà và cần y lệnh&lt;/span&gt;&lt;br&gt;• service_price &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="720" height="88" as="geometry"/></mxCell>
<mxCell id="c229" value="&lt;b&gt;6. Đặt lịch &amp;amp; điều phối&lt;/b&gt;&lt;br&gt;• care_order &lt;span style=&quot;color:#666&quot;&gt;– Đơn chăm sóc&lt;/span&gt;&lt;br&gt;• order_status_history &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• triage_assessment &lt;span style=&quot;color:#666&quot;&gt;– Phân loại triệu chứng 4 nhóm bằng AI hoặc bác sĩ trực; chỉ được bổ sung, không hạ mức&lt;/span&gt;&lt;br&gt;• order_assignment &lt;span style=&quot;color:#666&quot;&gt;– Mỗi lượt mời / gán ĐD cho đơn: BN chọn, tự gán, mời thay, điều thủ công&lt;/span&gt;&lt;br&gt;• replacement_case &lt;span style=&quot;color:#666&quot;&gt;– Báo nghỉ / đổi người / bom ca: tìm người thay và xét vi phạm một lần&lt;/span&gt;&lt;br&gt;• order_reschedule &lt;span style=&quot;color:#666&quot;&gt;– Đổi lịch đơn đặt trước đã cọc, tối đa 2 lần&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="884" width="720" height="142" as="geometry"/></mxCell>
<mxCell id="c230" value="&lt;b&gt;7. Thực hiện ca chăm sóc&lt;/b&gt;&lt;br&gt;• care_visit &lt;span style=&quot;color:#666&quot;&gt;– Diễn biến ca tại nhà: xuất phát, check-in, bắt đầu, kết thúc&lt;/span&gt;&lt;br&gt;• visit_location_point &lt;span style=&quot;color:#666&quot;&gt;– Vị trí ĐD từ lúc xuất phát đến check-in; phát hiện tắt định vị &amp;gt; 10 phút&lt;/span&gt;&lt;br&gt;• visit_code &lt;span style=&quot;color:#666&quot;&gt;– Mã hiển thị trên app BN để xác nhận trong ca: check-in, bảng kê, phát sinh, dừng ca&lt;/span&gt;&lt;br&gt;• care_report &lt;span style=&quot;color:#666&quot;&gt;– Báo cáo chăm sóc bắt buộc; đủ trường → ca Hoàn tất, lưu vào hồ sơ BN tại BV&lt;/span&gt;&lt;br&gt;• care_report_revision &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• handover &lt;span style=&quot;color:#666&quot;&gt;– Bàn giao khi thay người hoặc dừng ca: người giao, người nhận, nội dung&lt;/span&gt;&lt;br&gt;• addon_request &lt;span style=&quot;color:#666&quot;&gt;– Dịch vụ phát sinh trong ca nhánh A / B / C&lt;/span&gt;&lt;br&gt;• care_stop &lt;span style=&quot;color:#666&quot;&gt;– Dừng ca giữa chừng: lý do, phí tạm tính / chốt, đơn con&lt;/span&gt;&lt;br&gt;• chat_message &lt;span style=&quot;color:#666&quot;&gt;– Chat / gọi BN – ĐD trong app theo đơn, không dùng SĐT&lt;/span&gt;&lt;br&gt;• nurse_rating &lt;span style=&quot;color:#666&quot;&gt;– Đánh giá ĐD, không bắt buộc&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1046" width="720" height="214" as="geometry"/></mxCell>
<mxCell id="c231" value="&lt;b&gt;8. Bảng kê, thanh toán &amp;amp; hoàn tiền&lt;/b&gt;&lt;br&gt;• order_line &lt;span style=&quot;color:#666&quot;&gt;– Dòng bảng kê ca: dịch vụ gốc, phát sinh, vật tư, phí đến nhà&lt;/span&gt;&lt;br&gt;• line_dispute &lt;span style=&quot;color:#666&quot;&gt;– Khiếu nại dòng bảng kê trước&lt;/span&gt;&lt;br&gt;• payment_transaction &lt;span style=&quot;color:#666&quot;&gt;– Giao dịch cọc / phần còn lại qua cổng hoặc tiền mặt; tiền về TK bệnh viện&lt;/span&gt;&lt;br&gt;• gateway_webhook_event &lt;span style=&quot;color:#666&quot;&gt;– Kết quả giao dịch / hoàn tiền do cổng gửi về&lt;/span&gt;&lt;br&gt;• refund &lt;span style=&quot;color:#666&quot;&gt;– Lệnh hoàn tiền: tự động theo BR-04, ngoại lệ, thủ công sau thanh toán&lt;/span&gt;&lt;br&gt;• deposit_exception_request &lt;span style=&quot;color:#666&quot;&gt;– BN xin ngoại lệ hoàn cọc, QT BV duyệt&lt;/span&gt;&lt;br&gt;• cash_collection &lt;span style=&quot;color:#666&quot;&gt;– Thu tiền mặt tại nhà, hai bên cùng xác nhận số tiền&lt;/span&gt;&lt;br&gt;• cash_remittance &lt;span style=&quot;color:#666&quot;&gt;– ĐD nộp tiền mặt về thủ quỹ BV, hạn 48h&lt;/span&gt;&lt;br&gt;• financial_entry &lt;span style=&quot;color:#666&quot;&gt;– Sổ bút toán chỉ ghi thêm: cọc 4 nhóm, thu, hoàn, tiền mặt ĐD giữ / nộp, bù công&lt;/span&gt;&lt;br&gt;• patient_invoice &lt;span style=&quot;color:#666&quot;&gt;– Hóa đơn điện tử BV xuất cho BN, gồm hóa đơn điều chỉnh&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="720" height="214" as="geometry"/></mxCell>
<mxCell id="c232" value="&lt;b&gt;9. Đối soát &amp;amp; phí nền tảng&lt;/b&gt;&lt;br&gt;• reconciliation_period &lt;span style=&quot;color:#666&quot;&gt;– Kỳ đối chiếu tháng theo BV&lt;/span&gt;&lt;br&gt;• reconciliation_discrepancy &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• platform_fee_invoice &lt;span style=&quot;color:#666&quot;&gt;– Hóa đơn phí nền tảng gửi BV&lt;/span&gt;&lt;br&gt;• nurse_earning_statement &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• nurse_earning_item &lt;span style=&quot;color:#666&quot;&gt;– Chi tiết thu nhập ĐD theo đơn&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="720" height="124" as="geometry"/></mxCell>
<mxCell id="c233" value="&lt;b&gt;10. Khiếu nại, vi phạm, sự cố &amp;amp; SOS&lt;/b&gt;&lt;br&gt;• staff_violation &lt;span style=&quot;color:#666&quot;&gt;– Nhật ký vi phạm ĐD; đếm cửa sổ 30 ngày cuộn theo nhóm BR-01 / BR-02&lt;/span&gt;&lt;br&gt;• no_ack_event &lt;span style=&quot;color:#666&quot;&gt;– Lần không bấm Đã nhận đơn trong 5 phút&lt;/span&gt;&lt;br&gt;• complaint &lt;span style=&quot;color:#666&quot;&gt;– Khiếu nại về ĐD / nền tảng, báo cáo hành vi BN, phúc tra&lt;/span&gt;&lt;br&gt;• complaint_event &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• incident_report &lt;span style=&quot;color:#666&quot;&gt;– Sự cố tại nhà, ghi nhận riêng khỏi khiếu nại&lt;/span&gt;&lt;br&gt;• sos_incident &lt;span style=&quot;color:#666&quot;&gt;– SOS &amp;amp; ứng phó khẩn cấp; hệ thống không tự gọi 115&lt;/span&gt;&lt;br&gt;• sos_escalation_event &lt;span style=&quot;color:#666&quot;&gt;– Từng nấc báo SOS: đầu mối trực → quá 5 phút chưa xác nhận → đầu mối dự phòng, chỉ ghi thêm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="254" width="720" height="160" as="geometry"/></mxCell>
<mxCell id="c234" value="&lt;b&gt;11. AI rủi ro &amp;amp; tái khám&lt;/b&gt;&lt;br&gt;• risk_assessment &lt;span style=&quot;color:#666&quot;&gt;– AI phân tích rủi ro từ báo cáo chăm sóc&lt;/span&gt;&lt;br&gt;• risk_alert &lt;span style=&quot;color:#666&quot;&gt;– Cảnh báo rủi ro cao gửi bác sĩ phụ trách / trực&lt;/span&gt;&lt;br&gt;• followup_case &lt;span style=&quot;color:#666&quot;&gt;– Đề xuất → xác nhận → phân công → kế hoạch tái khám&lt;/span&gt;&lt;br&gt;• doctor_access_grant &lt;span style=&quot;color:#666&quot;&gt;– Quyền có thời hạn cho bác sĩ xem lịch sử chăm sóc tại BV mình; BN thu hồi được&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="434" width="720" height="106" as="geometry"/></mxCell>
<mxCell id="c235" value="&lt;b&gt;12. Dữ liệu cá nhân (xóa dữ liệu)&lt;/b&gt;&lt;br&gt;• data_deletion_request &lt;span style=&quot;color:#666&quot;&gt;– Yêu cầu xóa dữ liệu, xử lý trong 72h&lt;/span&gt;&lt;br&gt;• data_deletion_item &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="720" height="70" as="geometry"/></mxCell>
<mxCell id="c236" value="&lt;b&gt;13. Thông báo, hẹn giờ &amp;amp; quyết định tự động&lt;/b&gt;&lt;br&gt;• notification &lt;span style=&quot;color:#666&quot;&gt;– &lt;/span&gt;&lt;br&gt;• scheduled_timer &lt;span style=&quot;color:#666&quot;&gt;– Bộ hẹn giờ ⏱ của các luồng; worker quét due_at để chạy hành động hết hạn&lt;/span&gt;&lt;br&gt;• overdue_decision &lt;span style=&quot;color:#666&quot;&gt;– Quyết định tài chính tự động khi quá hạn, lưu mã Fx + mốc + lý do&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="650" width="720" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="01. Bệnh viện &amp; cấu hình"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c237" value="&lt;b style=font-size:20px&gt;Nhóm 1. Bệnh viện &amp;amp; cấu hình&lt;/b&gt;&lt;br&gt;PK khóa chính · FK khóa ngoại · UQ duy nhất · NN bắt buộc. Ký hiệu crow&amp;#39;s foot: │ một, ○ không bắt buộc, ⋔ nhiều. Bảng xám = bảng thuộc nhóm khác. FK tới &lt;i&gt;user_account&lt;/i&gt; và &lt;i&gt;hospital&lt;/i&gt; chỉ ghi ở cột, không vẽ đường (trừ trang của chính hai bảng này)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/></mxCell>
<UserObject id="c238" label="hospital" tooltip="Bệnh viện (tenant) ký hợp đồng với nền tảng, đứng tên nhận tiền (UC80, BR-05)"><mxCell style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="234" as="geometry"/></mxCell></UserObject>
<mxCell id="c239" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;PK&lt;/td&gt;&lt;td&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;uuid NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="30" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c240" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;UQ&lt;/td&gt;&lt;td&gt;code&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="52" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c241" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;name&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="74" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c242" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;tax_code&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;text&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="96" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c243" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;hospital_status NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="118" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c244" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;contract_start&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;date&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="140" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c245" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;contract_end&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;date&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="162" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c246" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;ai_enabled&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;boolean NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="184" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c247" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;timestamptz NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c238"><mxGeometry y="206" width="330" height="22" as="geometry"/></mxCell>
<UserObject id="c248" label="facility" tooltip="Cơ sở của bệnh viện; BN chọn cơ sở khi đặt lịch, vùng phục vụ tính theo cơ sở (BR-06)"><mxCell style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="330" height="256" as="geometry"/></mxCell></UserObject>
<mxCell id="c249" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;color:#555&quot;&gt;PK&lt;/td&gt;&lt;td&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;uuid NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="c248"><mxGeometry y="30" width="330" height="22" as="geometry"/></mxCell>

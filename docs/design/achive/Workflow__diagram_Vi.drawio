ách hàng hủy lịch&lt;/b&gt;&lt;br&gt;&lt;span style=font-size:12px;color:#475569&gt;Use case: Hủy lịch — Ma trận chính sách hủy, mục 5.2 (kịch bản 1–5) · HealthCareSystem — On-Demand Nursing · Nguồn: SRS v2.0&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1260" height="60" as="geometry"/></mxCell><mxCell id="AD07_lane0" value="Khách hàng" style="swimlane;html=1;startSize=44;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#334155;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="300" height="1552" as="geometry"/></mxCell><mxCell id="AD07_lane1" value="Hệ thống" style="swimlane;html=1;startSize=44;fillColor=#E2E8F0;swimlaneFillColor=#FFFFFF;strokeColor=#334155;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="600" height="1552" as="geometry"/></mxCell><mxCell id="AD07_lane2" value="Điều dưỡng" style="swimlane;html=1;startSize=44;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#334155;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="930" y="96" width="300" height="1552" as="geometry"/></mxCell><mxCell id="AD07_s" value="" style="ellipse;html=1;shape=startState;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="AD07_lane0"><mxGeometry x="138.0" y="70.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="AD07_k1" value="Chọn đơn, bấm Hủy và nêu lý do" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD07_lane0"><mxGeometry x="52.0" y="140.0" width="196.0" height="49.0" as="geometry"/></mxCell><mxCell id="AD07_d0" value="Đơn đang IN_PROGRESS (đã Check-in)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;spacing=14;" vertex="1" parent="AD07_lane1"><mxGeometry x="58.0" y="235.0" width="184.0" height="91.0" as="geometry"/></mxCell><mxCe
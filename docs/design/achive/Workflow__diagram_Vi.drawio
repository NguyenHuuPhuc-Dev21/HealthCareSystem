=14;" vertex="1" parent="AD05_lane0"><mxGeometry x="148.0" y="577.5" width="184.0" height="74.0" as="geometry"/></mxCell><mxCell id="AD05_d3" value="Y lệnh gốc &amp;amp; thuốc khớp, còn hạn?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;spacing=14;" vertex="1" parent="AD05_lane0"><mxGeometry x="28.0" y="697.5" width="184.0" height="76.0" as="geometry"/></mxCell><mxCell id="AD05_m1" value="" style="rhombus;html=1;fillColor=#FEF3C7;strokeColor=#B45309;" vertex="1" parent="AD05_lane0"><mxGeometry x="345.0" y="720.5" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="AD05_b2" value="Bấm &amp;#x27;Từ chối ca do y lệnh không hợp lệ&amp;#x27; + ảnh bằng chứng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane0"><mxGeometry x="22.0" y="819.5" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_b3" value="Xác nhận tình trạng bệnh nhân (30 phút đầu)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane0"><mxGeometry x="262.0" y="827.2" width="196.0" height="49.0" as="geometry"/></mxCell><mxCell id="AD05_x3" value="Hủy đơn, ĐD không bị phạt &amp;amp; nhận đền bù đi lại; hoàn tiền Khách" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane1"><mxGeometry x="22.0" y="935.8" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_d4" value="Đúng như khai báo?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;spacing=14;" vertex="1" parent="AD05_lane0"><mxGeometry x="268.0" y="930.0" width="184.0" height="76.0" as="geometry"/></mxCell><mxCell id="AD05_eA" value="" style="ellipse;html=1;shape=endState;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="AD05_lane1"><mxGeometry x="106.0" y="1070.2" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="AD05_b4" value="Gửi yêu cầu cập nhật phụ phí hoặc từ chối ca không phạt" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane0"><mxGeometry x="22.0" y="1052.0" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_m2" value="" style="rhombus;html=1;fillColor=#FEF3C7;strokeColor=#B45309;" vertex="1" parent="AD05_lane0"><mxGeometry x="345.0" y="1069.2" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="AD05_b5" value="Chăm sóc &amp;amp; ghi nhật ký y khoa: mạch, nhiệt độ, huyết áp, SpO2, hoạt động" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane0"><mxGeometry x="142.0" y="1162.5" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_x4" value="Lưu shift_logs, đồng bộ realtime qua WebSocket" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane1"><mxGeometry x="142.0" y="1273.0" width="196.0" height="49.0" as="geometry"/></mxCell><mxCell id="AD05_k2" value="Theo dõi nhật ký ca trực" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane2"><mxGeometry x="62.0" y="1277.5" width="196.0" height="40.0" as="geometry"/></mxCell><mxCell id="AD05_d5" value="Muốn gia hạn? (trước 30&amp;#x27; cuối ca)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;spacing=14;" vertex="1" parent="AD05_lane2"><mxGeometry x="68.0" y="1368.0" width="184.0" height="76.0" as="geometry"/></mxCell><mxCell id="AD05_d6" value="Đồng ý gia hạn? (không vướng ca kế tiếp)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;spacing=14;" vertex="1" parent="AD05_lane0"><mxGeometry x="148.0" y="1490.0" width="184.0" height="91.0" as="geometry"/></mxCell><mxCell id="AD05_k3" value="Thanh toán bổ sung phí gia hạn (bội số 1 giờ) vào Escrow" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane2"><mxGeometry x="62.0" y="1627.0" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_m3" value="" style="rhombus;html=1;fillColor=#FEF3C7;strokeColor=#B45309;" vertex="1" parent="AD05_lane0"><mxGeometry x="225.0" y="1737.5" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="AD05_b6" value="Check-out: giờ kết thúc thực tế, sinh hiệu cuối ca, việc đã làm, ghi chú bàn giao" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane0"><mxGeometry x="142.0" y="1813.5" width="196.0" height="64.5" as="geometry"/></mxCell><mxCell id="AD05_x5" value="Ghi checkout_time, đơn COMPLETED; mở cửa sổ khiếu nại 24h, thu hồi quyền xem bệnh án sau 12h, mở đánh giá 2 chiều" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;" vertex="1" parent="AD05_lane1"><mxGeometry x="142.0" y="1924.0" width="196.0" height="95.5" as="geometry"/></mxCell><mxCell id="AD05_e" value="" style="ellipse;html=1;shape=endState;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="AD05_lane1"><mxGeometry x="226.0" y="2065.5" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="AD05_e0" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=11;fontColor=#B45309;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="AD05_s" target="AD05_b1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="AD05_e1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E
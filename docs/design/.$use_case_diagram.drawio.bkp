        <mxCell id="u108" value="UC108. Cấu hình bệnh viện (giá, vùng phục vụ, tỷ lệ chia, mức phạt/hoàn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">

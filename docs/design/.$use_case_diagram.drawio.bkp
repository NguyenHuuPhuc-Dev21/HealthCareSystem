          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n740" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=8;spacingRight=8;" value="Vùng phục vụ (UC27, BR-06): địa chỉ chăm sóc phải nằm trong bán kính / thời gian di chuyển do cơ sở cấu hình — không xét quê quán, không dùng ranh giới tỉnh. VD: quê Quảng Trị đang ở Đà Nẵng → đặt được cơ sở Đà Nẵng; khám ở Đà Nẵng rồi về Quảng Trị → KHÔNG đặt được điều dưỡng Đà Nẵng." vertex="1">
          <mxGeometry height="60" width="1230" x="180" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="n810" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=8;spacingRight=8;" value="AI lỗi → bác sĩ trực của cơ sở phân loại trong 10 phút (BR-10). BN không được hạ mức dưới ngưỡng nguy hiểm. Mỗi cơ sở độc lập: hết điều dưỡng thì báo BN (UC87), không tự chuyển cơ sở khác. Khung giờ: BR-03." vertex="1">
          <mxGeometry height="50" width="1230" x="180" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="n870" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=8;spacingRight=8;" value="Hai chế độ: HẸN TRƯỚC → BN tự chọn điều dưỡng (UC112) trong danh sách có lịch trống, gửi yêu cầu chỉ định (UC113), ĐD xác nhận (UC115, trang 4). ĐẶT NGAY → ghép nhanh (UC25): hệ thống tự gán lần lượt ĐD đang bật &quot;Đang rảnh&quot;, ĐD không có nút từ chối. Với đơn hẹn trước, hệ thống nhắc lịch và mời BN cập nhật triệu chứng nếu có – không bắt buộc (UC119, bản 8). Quy tắc: BR-13." vertex="1">
          <mxGeometry height="60" width="1230" x="180" y="1420" as="geometry" />
        </mxCell>

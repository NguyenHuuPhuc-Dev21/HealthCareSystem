        <mxCell id="e21" edge="1" parent="1" source="u8" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" target="u7" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" edge="1" parent="1" source="u8" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" target="u12" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n970" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" value="Điều dưỡng và bác sĩ là nhân viên bệnh viện, KHÔNG tự đăng ký. Bản 8 – xác minh 2 bước (BR-21): Quản trị bệnh viện tạo và gửi hồ sơ (UC5, UC10; không tải CCCD lên nền tảng), người có thẩm quyền của BV xác nhận chuyên môn và chịu trách nhiệm tính xác thực (UC139); Admin nền tảng chỉ kiểm tra tính đầy đủ và điều kiện vận hành rồi cấp account (UC7, UC12), không chứng thực CCHN. Thiếu / sai → yêu cầu bổ sung hoặc từ chối (UC8); bị từ chối được cập nhật lại thành phiên bản mới." vertex="1">
          <mxGeometry height="70" width="1230" x="220" y="970" as="geometry" />
        </mxCell>
        <mxCell id="n1040" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" value="Account Quản trị bệnh viện được tạo khi bệnh viện ký hợp đồng (UC80). Bệnh viện tự khóa / cập nhật account khi nhân viên nghỉ việc, CCHN hết hạn, chuyển khoa (UC81). Mỗi hồ sơ người thân cần consent riêng (UC4 include UC2); người thân là người lớn tự đồng ý qua link email (BR-17). Đăng ký BN chỉ bằng email (BR-20)." vertex="1">
          <mxGeometry height="50" width="1230" x="220" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="v7a4" edge="1" parent="1" source="a_AD" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" target="u8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="u139" value="UC139. Xác nhận chuyên môn hồ sơ nhân sự (bước 1 – BV chịu trách nhiệm tính xác thực)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="625" width="250" height="80" as="geometry" /></mxCell><mxCell id="v8a1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_QT" target="u139"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8d1" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u5" target="u139"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8d2" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u10" target="u139"><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>

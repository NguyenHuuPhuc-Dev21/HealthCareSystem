        <mxCell id="u16" value="UC16. Kiểm tra quyền ở backend: vai trò (gồm vai trò con QT BV) × bệnh viện × quan hệ với BN × ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">

        <mxCell id="lg0" value="Giữ nguyên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="Đã sửa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="Mới thêm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="470" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="Tham chiếu từ trang khác" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="470" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="on0" value="Quyết định 1 — Điều dưỡng &amp; bác sĩ là nhân viên bệnh viện; mỗi bệnh viện / cơ sở độc lập về nhân sự và dữ liệu. Nền tảng cấp account và phân quyền theo vai trò × bệnh viện." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on1" value="Quyết định 2 — Thêm actor Quản trị bệnh viện, gồm 4 vai trò con (Quản trị trưởng / Điều phối / Kế toán – Thu ngân / Nhân sự – Chất lượng; ma trận ở trang 13): gửi yêu cầu cấp account, xử lý khiếu nại, kỷ luật, điều người thay, phân công bác sĩ, cấu hình giá / vùng / chính sách. Admin nền tảng (chỉ một loại): cấp account, cấu hình hệ thống, đối chiếu &amp; thu phí, giám sát." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="582" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on2" value="Quyết định 3 — Nền tảng chỉ áp biện pháp kỹ thuật với điều dưỡng; tiền phạt / thưởng / kỷ luật theo chính sách bệnh viện (BR-01, BR-02)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="634" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on3" value="Quyết định 4 — Thanh toán qua cổng thanh toán, bệnh viện đứng tên nhận tiền (không lấy dữ liệu qua API bệnh viện); BN đặt cọc 30% trong 15 phút sau khi ĐD đồng ý (hẹn trước) hoặc sau khi ĐD bấm 'Đã nhận đơn' (đặt ngay), trả phần còn lại sau ca (cổng hoặc tiền mặt), bệnh viện xuất hóa đơn khi thu đủ; nền tảng thu phí % theo đơn hoàn thành (BR-04, BR-05)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="686" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on4" value="Quyết định 5 — Nhận đơn 17:00–21:30 ngày thường, 07:00–21:30 cuối tuần &amp; lễ (BR-03); vùng phục vụ theo bán kính / thời gian di chuyển, không theo quê quán hay tỉnh (BR-06)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="738" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on5" value="Quyết định 6 — Quyết định y khoa (phân loại khi AI lỗi, xử lý cảnh báo rủi ro cao) do bác sĩ của bệnh viện, không do Admin." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on6" value="Quyết định 7 — Hẹn trước: bệnh nhân tự chọn điều dưỡng, điều dưỡng xác nhận. Điều dưỡng có việc đột xuất → hệ thống ghép tự động (AI hỗ trợ xếp hạng) tìm người thay ngay, bệnh viện xác nhận lý do song song, bệnh nhân chọn phương án (BR-13). Đặt ngay: hệ thống TỰ GÁN điều dưỡng đang bật &amp;quot;Đang rảnh&amp;quot;, không có nút từ chối; ĐD chỉ bấm &amp;quot;Đã nhận đơn&amp;quot; (BR-01, BR-08) — mô hình tự gán cần bệnh viện xác nhận về quan hệ lao động." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="842" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="on7" value="Đánh số — Giữ nguyên mã UC cũ; UC mới đánh từ UC80; bản 5 thêm UC127–UC138, bản 6 gộp UC35 vào UC116, bản 7 chỉ sửa nội dung (không thêm mã), bản 8 thêm UC139, UC140 và bỏ UC130, UC132 (UC131 cố ý bỏ trống vì bản cũ đã dùng mã này sai). Bảng quyết định tài chính khi quá hạn ở trang 14. UC29, UC70, UC71, UC73–UC76 đã gộp (xem trang 11). Quy tắc nghiệp vụ chi tiết ở trang 12." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="894" width="1500" height="44" as="geometry" />
        </mxCell>
      <mxCell id="on8" value="Bản 8 (16/10/2026, đồng bộ luong_hoat_dong_v8.14) — Đăng nhập chỉ bằng email, không thu CCCD, không xác minh tuổi (BR-20); bỏ luồng 16 (chuyển hồ sơ khi tròn 18 tuổi) và 09B (hoàn tiền sau thanh toán làm thủ công qua UC90); xác minh hồ sơ nhân sự 2 bước (BR-21); báo cáo chăm sóc bắt buộc theo loại dịch vụ (BR-22); SOS cho BN / người nhà (BR-23); dịch vụ phát sinh A / B / C (BR-15); không bắt buộc sàng lọc lại trước ca (UC119); ngưỡng BR-01 = 3 lần / 30 ngày. Bản 8.1: tách F1a / F1b (Q-44); thêm vào BR các quy tắc trước đây chỉ có ở file luồng – tự mở khóa bom ca 24h (BR-02, Q-43), lượt ghép mới sau hủy nhận (BR-01, Q-45), hậu kiểm lý do không an toàn (BR-16, Q-46), đối soát cọc 4 nhóm (BR-04); BR-14 định nghĩa rõ 'Công nợ'." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="946" width="1500" height="70" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>

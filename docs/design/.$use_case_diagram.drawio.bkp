        <mxCell id="u103" value="UC103. Giám sát cảnh báo quá hạn chưa xử lý" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">

          <mxGeometry height="50" width="930" x="220" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="n1215" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="Đặt cọc 30% trong 15 phút sau khi ĐD đồng ý (UC45); phần còn lại thanh toán sau ca qua cổng hoặc tiền mặt (UC121–UC123); hóa đơn điện tử do bệnh viện xuất khi đã thu đủ (UC126). Tiền mặt ĐD nộp về bệnh viện trong 48 giờ (UC124, UC125)." vertex="1">
          <mxGeometry height="60" width="930" x="220" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="n1285" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="Hoàn cọc: nền tảng tạo lệnh, bệnh viện thực hiện (UC90, BR-04). Thu nhập điều dưỡng: nền tảng tính theo chính sách bệnh viện cấu hình (UC108) và xuất bảng kê (UC96); bệnh viện chi trả." vertex="1">

        <mxCell id="n940" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=8;spacingRight=8;" value="Bản 5: trước khi giữ slot, hệ thống chặn nếu tài khoản có công nợ quá hạn, hồ sơ đã có lịch trùng giờ hoặc vượt số lịch chưa hoàn thành (BR-14). Dịch vụ gốc thuộc danh mục cần y lệnh → BN tải chỉ định (UC136), bác sĩ trực kiểm tra (UC137) trước khi chọn ĐD (BR-15). Đặt hộ (UC135): QT BV vai trò Điều phối đặt thay cho BN ít dùng công nghệ, BN xác nhận consent &amp;amp; cọc qua link gửi tới email – chưa có luồng riêng." vertex="1">
          <mxGeometry height="60" width="1230" x="180" y="1500" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u63" target="u62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u105" target="u62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u64" target="u63">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u63" target="u65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n510" value="Xử lý trong 72 giờ; còn 24h → cảnh báo Admin, quá hạn → ghi báo cáo SLA tháng gửi PO (chỉ một loại Admin). Dữ liệu phải lưu trữ theo luật (hồ sơ chăm sóc, chứng từ thanh toán) được khóa truy cập / ẩn danh thay vì xóa (UC104) và báo rõ cho BN. Xóa cả bản đã chia sẻ cho bệnh viện. Actor &quot;Bệnh nhân / Người nhà&quot; gồm chủ tài khoản và người thân có hồ sơ; người thân đã tự đồng ý qua email dùng link gửi tới email của chính họ để rút đồng ý (UC106) hoặc yêu cầu xóa (UC61). Bản 8: xác thực lại bằng OTP email; bỏ UC130, UC132 (không xác minh tuổi, bỏ luồng 16). Quy tắc: BR-12, BR-17, BR-20." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="510" width="1230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u129" value="UC129. Xử lý đơn đang chạy khi rút đồng ý (BR-17)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="275" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u138" value="UC138. Đồng ý lại điều khoản phiên bản mới" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="390" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v5d17" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u106" target="u129">
          <mxGeometry relative="1" as="geometry" x="-0.6" />
        </mxCell>
        <mxCell id="v5a20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_BN" target="u138">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v7a6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_AD" target="u105">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="50" />
              <mxPoint x="835" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

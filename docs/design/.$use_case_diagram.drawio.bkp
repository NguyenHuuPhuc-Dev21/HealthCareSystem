        <mxCell id="e30" edge="1" parent="1" source="u36" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#555555;" target="u34" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n970" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="Nền tảng chỉ áp biện pháp KỸ THUẬT (giảm ưu tiên ghép đơn, khóa nhận ca, ghi log). Trừ tiền, thưởng, kỷ luật, điều người thay là việc của bệnh viện dựa trên dữ liệu nền tảng cung cấp. Chi tiết: BR-01 (không xác nhận đơn tự gán), BR-02 (hủy ca), BR-07 (bom ca), BR-04 (hoàn tiền); UC72 chỉ áp khi QT BV không xác nhận bất khả kháng (UC72 «extend» UC88, luồng 06); quá hạn của QT BV: BR-18 (trang 14) — trang 12." vertex="1">
          <mxGeometry height="60" width="1230" x="210" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="n1040" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="Điều dưỡng đã đồng ý nhưng có việc đột xuất: báo không đi được (UC116) → hệ thống tìm người thay NGAY (UC37: xa giờ hẹn dùng lịch trống, sát giờ dùng &quot;Đang rảnh&quot;; AI chỉ hỗ trợ xếp hạng mức phù hợp) → BN chọn đồng ý / chọn người khác / đổi giờ / hủy hoàn 100% (UC117). Song song, Quản trị BV xác nhận lý do (UC88) để quyết định có tính vi phạm hay không. Không tìm được → Quản trị BV điều người (UC78)." vertex="1">
          <mxGeometry height="70" width="1230" x="210" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="n1120" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="UC70, UC71 gộp vào UC33; UC73–UC76 gộp vào UC72; UC35 (hủy ca đã nhận) gộp vào UC116 (báo không đi được). Đặt ngay không có nút từ chối: ĐD không bấm 'Đã nhận đơn' trong 5 phút → gỡ gán, tự tắt 'Đang rảnh', hệ thống tự gán người tiếp theo (UC25); chỉ ghi vi phạm khi lặp lại 3 lần / 30 ngày (BR-01, bản 8). ĐD hủy trong 5 phút sau khi bấm 'Đã nhận đơn' và trước khi BN cọc → ghi ngay 1 vi phạm BR-01 (ngoại lệ BR-02, Q-41). Vi phạm của ĐD chỉ xét MỘT lần cho mỗi đơn tại luồng 06." vertex="1">
          <mxGeometry height="50" width="1230" x="210" y="1490" as="geometry" />
        </mxCell>
        <mxCell id="u25" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" value="UC25. Ghép nhanh – tự gán ĐD đang rảnh&lt;br&gt;&lt;i&gt;(xem trang 3)&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="1160" y="420" as="geometry" />
        </mxCell>

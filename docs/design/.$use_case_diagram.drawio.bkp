        <mxCell id="e5" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u66" target="u67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="u107" target="u67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n395" value="Admin xem toàn hệ thống và cấu hình tham số chung (UC109). Quản trị bệnh viện chỉ xem dữ liệu bệnh viện mình và cấu hình giá, vùng phục vụ, tỷ lệ chia, mức phạt / hoàn trong giới hạn Admin cho phép (UC108)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="395" width="930" height="50" as="geometry" />
        </mxCell>
      </root>

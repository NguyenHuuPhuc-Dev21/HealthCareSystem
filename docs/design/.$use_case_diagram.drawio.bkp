          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n855" value="BN có thể khám nhiều bệnh viện độc lập. Sau khi BN xác nhận tái khám tại một bệnh viện (UC57), Quản trị bệnh viện đó phân công bác sĩ (UC13) → bác sĩ được quyền xem lịch sử chăm sóc CHỈ tại bệnh viện mình, có thời hạn (UC58, UC59). BN có thể thu hồi quyền (UC102). Luồng 13 đã sửa theo đúng phạm vi này (bản 6); xem lịch sử ở BV khác là quyết định còn mở, chưa hỗ trợ." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="855" width="930" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n925" value="Cảnh báo rủi ro cao gửi bác sĩ phụ trách (chưa có thì bác sĩ trực) để xử lý (UC68); chỉ ca khẩn cấp mới báo ngay BN / người nhà (hướng dẫn gọi 115). Đề xuất tái khám (UC56) chỉ gửi BN sau khi bác sĩ xác nhận (UC56 «extend» UC68). Admin không ra quyết định y khoa, chỉ giám sát cảnh báo quá hạn (UC103). AI lỗi / không trả kết quả sau 3 lần thử trong 30 phút, hoặc BV tắt AI → coi như rủi ro cao, bác sĩ xem tất cả báo cáo (BR-10)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="925" width="930" height="50" as="geometry" />
        </mxCell>

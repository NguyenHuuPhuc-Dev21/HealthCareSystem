        <mxCell id="n1085" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=8;spacingRight=8;" value="Nền tảng tích hợp MỘT cổng thanh toán cho mọi bệnh viện; mỗi bệnh viện đăng ký với cổng và đứng tên nhận tiền (UC110), nên tiền vào thẳng tài khoản bệnh viện và nền tảng không giữ tiền. Cổng tự gửi kết quả giao dịch về hệ thống (UC47) — không phụ thuộc API / IT của bệnh viện. Mọi bệnh viện đều dùng cổng; API đối soát của cổng lỗi / thiếu dữ liệu → tải sao kê để đối chiếu (UC111)." vertex="1">
          <mxGeometry height="60" width="930" x="220" y="1530" as="geometry" />

# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL Database (Tenant-Isolated)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Job Queues
REDIS_URL=redis://localhost:6379

# Cryptographic & Auth Secrets
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
OTP_SECRET=replace_with_another_secure_secret_for_otp_hashing

# Payment Gateway Configuration
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_hmac_webhook_secret
PAYMENT_GATEWAY_API_URL=https://sandbox.paymentgateway.example.com

# Notification Services (Mocked in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
FROM_EMAIL=no-reply@healthcare.example.com

# Cloud Storage (Signed URLs)
STORAGE_BUCKET_NAME=healthcare-clinical-media-private
STORAGE_REGION=ap-southeast-1

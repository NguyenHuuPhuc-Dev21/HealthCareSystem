# Copy to services/api/.env — never commit the real .env.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/healthcare_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Integration tests use a separate database
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/healthcare_test

# system_configs cache lifetime (ms)
CONFIG_CACHE_TTL_MS=60000

# Redis (job queue, locks, OTP, sessions)
REDIS_URL=redis://localhost:6379

# Auth (accounts-otp). OTP_SECRET: long random value (≥ 32 chars) in every real environment.
OTP_SECRET=replace_with_another_secure_secret_for_otp_hashing
# Development/QA only: return the OTP in the /auth/request-otp response (no SMS provider yet).
# Refused at startup when NODE_ENV=production.
OTP_DEV_ECHO=true
# Admin 2FA: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; locally a key derived from OTP_SECRET is used if empty.
TOTP_ENCRYPTION_KEY=

# Payment gateway (Phase 3/5 — BE-3)
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_hmac_webhook_secret
PAYMENT_GATEWAY_API_URL=https://sandbox.paymentgateway.example.com

# Private object storage — MinIO locally (docker-compose), S3 in cloud
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET_NAME=healthcare-clinical-media-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123

# Job Queue (BE-2) — thông số kỹ thuật, không phải số nghiệp vụ §5.1
JOB_QUEUE_NAME=healthcare-jobs
JOB_MAX_ATTEMPTS=5
JOB_BACKLOG_ALERT_THRESHOLD=100

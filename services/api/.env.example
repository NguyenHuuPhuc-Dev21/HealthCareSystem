# Copy to services/api/.env — never commit the real .env.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/healthcare_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Integration tests use a separate database
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/healthcare_test

# system_configs cache lifetime (ms)
CONFIG_CACHE_TTL_MS=60000

# Redis (job queue, locks, OTP, sessions)
REDIS_URL=redis://localhost:6379
# notifications (BE-3 · Phase 6): realtime goes through Redis pub/sub; 'local' = in-process only (one dev process)
# NOTIFICATIONS_REALTIME=local

# Auth (accounts-otp). OTP_SECRET: long random value (≥ 32 chars) in every real environment.
OTP_SECRET=replace_with_another_secure_secret_for_otp_hashing
# OTP delivery channel (OD-09). mock = nothing is sent; the code is readable at
#   GET /api/v1/auth/dev/otp-inbox?phone=...   (dev/staging only — refused in production)
# zns  = Zalo ZNS, not implemented yet (needs a Zalo Official Account).
# Unset = mock outside production; required in production.
OTP_CHANNEL=mock
# Optional: when set, the mock inbox requires the header  X-OTP-Inbox-Key: <this value>.
# Set it on any environment people outside the team can reach (staging).
OTP_MOCK_INBOX_KEY=
# Development/QA only: return the OTP in the /auth/request-otp response (no SMS provider yet).
# Refused at startup when NODE_ENV=production.
OTP_DEV_ECHO=true
# Admin 2FA: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; locally a key derived from OTP_SECRET is used if empty.
TOTP_ENCRYPTION_KEY=

# Payment gateway (Phase 3/5 — BE-3)
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_hmac_webhook_secret
PAYMENT_GATEWAY_API_URL=https://sandbox.paymentgateway.example.com
# Account customers transfer to (VietQR on the payment page). All four set → QR + transfer details shown.
PAYMENT_RECEIVING_BANK_BIN=970422
PAYMENT_RECEIVING_BANK_NAME=MB Bank (sandbox)
PAYMENT_RECEIVING_ACCOUNT_NO=0000000000
PAYMENT_RECEIVING_ACCOUNT_NAME=CARENEST ESCROW SANDBOX
# Dev/demo only: enables POST /api/v1/payments/dev/simulate-escrow (never in production)
PAYMENT_SIMULATOR_ENABLED=false
# Nurse deposit custody account (ADR-0004 D1). Unset → the PAYMENT_RECEIVING_* sandbox account is used.
# The simulator flag above also enables POST /api/v1/wallets/deposit/topups/:id/dev/simulate
DEPOSIT_CUSTODY_PARTNER_NAME=Ngân hàng đối tác lưu ký (mô phỏng)
DEPOSIT_CUSTODY_BANK_BIN=
DEPOSIT_CUSTODY_BANK_NAME=
DEPOSIT_CUSTODY_ACCOUNT_NO=
DEPOSIT_CUSTODY_ACCOUNT_NAME=

# Private object storage — MinIO locally (docker-compose), S3 in cloud
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET_NAME=healthcare-clinical-media-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123

# Job Queue (BE-2) — thông số kỹ thuật, không phải số nghiệp vụ §5.1
JOB_QUEUE_NAME=healthcare-jobs
JOB_MAX_ATTEMPTS=5
JOB_BACKLOG_ALERT_THRESHOLD=100
